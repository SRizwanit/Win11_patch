<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12.0dip"
    app:cardCornerRadius="16.0dip"
    app:cardElevation="8.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.3">
            <ImageView
                android:id="@id/launcher_thumbnail"
                android:background="#ffe0e0e0"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="H,16:9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="vertical"
            android:padding="24.0dip"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@id/launcher_icon"
                    android:visibility="gone"
                    android:layout_width="64.0dip"
                    android:layout_height="64.0dip"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="16.0dip" />
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <TextView
                        android:textSize="22.0sp"
                        android:textStyle="bold"
                        android:textColor="#ff000000"
                        android:ellipsize="end"
                        android:id="@id/launcher_name"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2" />
                    <TextView
                        android:textSize="16.0sp"
                        android:textColor="#ff757575"
                        android:id="@id/launcher_category"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8.0dip" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.0dip">
                <ImageView
                    android:layout_width="20.0dip"
                    android:layout_height="20.0dip"
                    android:src="@drawable/star_black"
                    app:tint="#ffffc107" />
                <TextView
                    android:textSize="16.0sp"
                    android:textColor="#ff757575"
                    android:id="@id/launcher_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.5"
                    android:layout_marginStart="8.0dip" />
            </LinearLayout>
            <Space
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_weight="1.0" />
            <com.google.android.material.button.MaterialButton
                android:textSize="16.0sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:id="@id/install_button"
                android:layout_width="fill_parent"
                android:layout_height="56.0dip"
                android:layout_marginTop="16.0dip"
                android:text="@string/install_now_caps"
                android:insetTop="0.0dip"
                android:insetBottom="0.0dip"
                android:backgroundTint="#ff2196f3"
                app:cornerRadius="28.0dip"
                app:rippleColor="#40ffffff"
                style="@style/Widget.MaterialComponents.Button" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>