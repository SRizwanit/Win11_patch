<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.SplashScreen.DayNight" parent="@style/Base.Theme.SplashScreen">
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast">true</item>
    </style>
    <style name="Theme.MyApp.SplashScreen" parent="@style/Theme.SplashScreen">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/icon_spark_planet</item>
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
        <item name="postSplashScreenTheme">@style/Theme.FileExplorer.Light</item>
        <item name="windowActionBar">false</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/animated_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">3000</item>
        <item name="windowSplashScreenBackground">#ff323435</item>
    </style>
</resources>
