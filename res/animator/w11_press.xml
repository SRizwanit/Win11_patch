<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_pressed="true">
        <set>
            <objectAnimator
                android:interpolator="@interpolator/w11_standard"
                android:duration="@integer/w11_duration_faster"
                android:valueTo="0.96"
                android:valueType="floatType"
                android:propertyName="scaleX" />
            <objectAnimator
                android:interpolator="@interpolator/w11_standard"
                android:duration="@integer/w11_duration_faster"
                android:valueTo="0.96"
                android:valueType="floatType"
                android:propertyName="scaleY" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:interpolator="@interpolator/w11_decelerate"
                android:duration="@integer/w11_duration_normal"
                android:valueTo="1.0"
                android:valueType="floatType"
                android:propertyName="scaleX" />
            <objectAnimator
                android:interpolator="@interpolator/w11_decelerate"
                android:duration="@integer/w11_duration_normal"
                android:valueTo="1.0"
                android:valueType="floatType"
                android:propertyName="scaleY" />
        </set>
    </item>
</selector>