<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_empty="true">
        <layer-list>
            <item
                android:drawable="@drawable/arrow_right"
                android:left="@dimen/normal_margin"
                android:top="@dimen/thumb_top_bottom_margin"
                android:right="@dimen/normal_margin"
                android:bottom="@dimen/thumb_top_bottom_margin" />
        </layer-list>
    </item>
    <item
        android:state_expanded="true">
        <layer-list>
            <item
                android:drawable="@drawable/down_arrow"
                android:left="@dimen/normal_margin"
                android:top="@dimen/thumb_top_bottom_margin"
                android:right="@dimen/normal_margin"
                android:bottom="@dimen/thumb_top_bottom_margin" />
        </layer-list>
    </item>
</selector>