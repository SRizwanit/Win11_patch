    <item>
        <shape
            android:shape="oval">
            <gradient
                android:startColor="#ff2fd8ff"
                android:endColor="#ffb44dff"
                android:angle="45.0"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:left="2.0dip"
        android:top="2.0dip"
        android:right="2.0dip"
        android:bottom="2.0dip">
        <shape
            android:shape="oval">
            <solid
                android:color="#ff12162a" />
        </shape>
    </item>
</layer-list>