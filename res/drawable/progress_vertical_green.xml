<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@android:id/background">
        <shape>
            <corners
                android:radius="22.0dip" />
            <gradient
                android:startColor="#ffc8e6c8"
                android:endColor="#ffc8e6c8"
                android:angle="180.0"
                android:centerY="0.75"
                android:centerColor="#ffc8e6c8" />
        </shape>
    </item>
    <item
        android:id="@android:id/progress">
        <clip
            android:gravity="bottom"
            android:clipOrientation="vertical">
            <shape>
                <corners
                    android:radius="22.0dip" />
                <gradient
                    android:startColor="#ffa3d6a5"
                    android:endColor="#ffa3d6a5"
                    android:angle="180.0"
                    android:centerY="0.75"
                    android:centerColor="#ffa3d6a5" />
            </shape>
        </clip>
    </item>
</layer-list>