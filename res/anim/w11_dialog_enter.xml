<?xml version="1.0" encoding="utf-8"?>
<set
    android:shareInterpolator="false"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <scale
        android:interpolator="@interpolator/w11_decelerate"
        android:duration="@integer/w11_duration_normal"
        android:pivotX="50.0%"
        android:pivotY="50.0%"
        android:fromXScale="1.06"
        android:toXScale="1.0"
        android:fromYScale="1.06"
        android:toYScale="1.0" />
    <alpha
        android:interpolator="@interpolator/w11_decelerate"
        android:duration="@integer/w11_duration_fast"
        android:fromAlpha="0.0"
        android:toAlpha="1.0" />
</set>