<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:padding="12.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/rl_audio_preview"
        android:layout_width="80.0dip"
        android:layout_height="80.0dip">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@id/iv_ringtone_thumbnail"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:src="@drawable/bg_purple_rounded"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedCorner16" />
        <ImageView
            android:id="@id/iv_play"
            android:padding="@dimen/normal_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_play"
            android:layout_centerInParent="true"
            app:tint="@android:color/white" />
        <ProgressBar
            android:id="@id/pb_ringtone_loading"
            android:visibility="gone"
            android:layout_width="32.0dip"
            android:layout_height="32.0dip"
            android:layout_centerInParent="true"
            android:indeterminateTint="@android:color/white" />
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/ll_info"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12.0dip"
        android:layout_toStartOf="@id/btn_apply_ringtone"
        android:layout_toEndOf="@id/rl_audio_preview">
        <TextView
            android:textSize="16.0sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center_vertical"
            android:id="@id/tv_ringtone_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:drawablePadding="@dimen/medium_margin" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="#ff757575"
            android:id="@id/tv_ringtone_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.0dip"
            android:singleLine="true" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="#ff757575"
            android:id="@id/tv_ringtone_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.0dip"
            android:singleLine="true" />
        <HorizontalScrollView
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.0dip">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/ll_tags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </HorizontalScrollView>
    </LinearLayout>
    <Button
        android:textSize="14.0sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:id="@id/btn_apply_ringtone"
        android:layout_width="wrap_content"
        android:layout_height="36.0dip"
        android:layout_marginLeft="@dimen/medium_margin"
        android:text="@string/apply"
        android:layout_centerVertical="true"
        android:insetTop="0.0dip"
        android:insetBottom="0.0dip"
        android:textAllCaps="false"
        android:paddingStart="16.0dip"
        android:paddingEnd="16.0dip"
        android:layout_alignParentEnd="true"
        android:backgroundTint="#ff0084ff"
        app:cornerRadius="18.0dip" />
</RelativeLayout>