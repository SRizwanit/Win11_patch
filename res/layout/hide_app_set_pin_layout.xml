<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:paddingTop="16.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24.0dip"
    android:paddingEnd="24.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.google.android.material.textfield.TextInputLayout
        android:id="@id/til_enter_old_pin"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8.0dip"
        android:hint="@string/enter_old_pin"
        style="@style/PinDialogField">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@id/et_enter_old_pin"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:maxLength="5"
            android:inputType="numberPassword"
            android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@id/til_enter_pin"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:hint="@string/enter_pin"
        style="@style/PinDialogField">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@id/et_enter_pin"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:maxLength="5"
            android:inputType="numberPassword"
            android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@id/til_confirm_pin"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:hint="@string/confirm_pin"
        style="@style/PinDialogField">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@id/et_confirm_pin"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:maxLength="5"
            android:inputType="numberPassword"
            android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>