<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/preview_file_manager"
    android:background="@android:color/white"
    android:visibility="gone"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/preview_fm_title_bar"
        android:layout_width="fill_parent"
        android:layout_height="22.0dip"
        android:paddingStart="4.0dip"
        android:paddingEnd="4.0dip">
        <ImageView
            android:layout_width="13.0dip"
            android:layout_height="13.0dip"
            android:src="@drawable/pc"
            android:contentDescription="@null" />
        <TextView
            android:textSize="7.0sp"
            android:textColor="@android:color/black"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/this_pc"
            android:includeFontPadding="false"
            android:layout_weight="1.0"
            android:layout_marginStart="4.0dip" />
        <ImageView
            android:layout_width="11.0dip"
            android:layout_height="11.0dip"
            android:src="@drawable/min_n"
            android:contentDescription="@null"
            android:layout_marginEnd="5.0dip" />
        <ImageView
            android:layout_width="11.0dip"
            android:layout_height="11.0dip"
            android:src="@drawable/max_n"
            android:contentDescription="@null"
            android:layout_marginEnd="5.0dip" />
        <ImageView
            android:layout_width="11.0dip"
            android:layout_height="11.0dip"
            android:src="@drawable/cross_n"
            android:contentDescription="@null" />
    </LinearLayout>
    <View
        android:background="#ffd3d3d3"
        android:layout_width="fill_parent"
        android:layout_height="1.0dip" />
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="4.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="3.0dip"
        android:paddingEnd="3.0dip">
        <LinearLayout
            style="@style/IntroPreviewFmTool">
            <ImageView
                android:src="@drawable/cut_n"
                android:contentDescription="@null"
                style="@style/IntroPreviewFmToolIcon" />
            <TextView
                android:text="@string/cut"
                style="@style/IntroPreviewFmToolLabel" />
        </LinearLayout>
        <LinearLayout
            style="@style/IntroPreviewFmTool">
            <ImageView
                android:src="@drawable/copy_n"
                android:contentDescription="@null"
                style="@style/IntroPreviewFmToolIcon" />
            <TextView
                android:text="@string/copy"
                style="@style/IntroPreviewFmToolLabel" />
        </LinearLayout>
        <LinearLayout
            style="@style/IntroPreviewFmTool">
            <ImageView
                android:src="@drawable/past_n"
                android:contentDescription="@null"
                style="@style/IntroPreviewFmToolIcon" />
            <TextView
                android:text="@string/paste"
                style="@style/IntroPreviewFmToolLabel" />
        </LinearLayout>
        <LinearLayout
            style="@style/IntroPreviewFmTool">
            <ImageView
                android:src="@drawable/delet_n"
                android:contentDescription="@null"
                style="@style/IntroPreviewFmToolIcon" />
            <TextView
                android:text="@string/delete"
                style="@style/IntroPreviewFmToolLabel" />
        </LinearLayout>
        <LinearLayout
            style="@style/IntroPreviewFmTool">
            <ImageView
                android:src="@drawable/rename_n"
                android:contentDescription="@null"
                style="@style/IntroPreviewFmToolIcon" />
            <TextView
                android:text="@string/rename"
                style="@style/IntroPreviewFmToolLabel" />
        </LinearLayout>
        <LinearLayout
            style="@style/IntroPreviewFmTool">
            <ImageView
                android:src="@drawable/properties_n"
                android:contentDescription="@null"
                style="@style/IntroPreviewFmToolIcon" />
            <TextView
                android:text="@string/properties"
                style="@style/IntroPreviewFmToolLabel" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="20.0dip"
        android:paddingStart="4.0dip"
        android:paddingEnd="4.0dip">
        <ImageView
            android:layout_width="10.0dip"
            android:layout_height="10.0dip"
            android:src="@drawable/left"
            android:contentDescription="@null" />
        <ImageView
            android:layout_width="10.0dip"
            android:layout_height="10.0dip"
            android:src="@drawable/right"
            android:contentDescription="@null"
            android:layout_marginStart="5.0dip" />
        <ImageView
            android:layout_width="10.0dip"
            android:layout_height="10.0dip"
            android:src="@drawable/up"
            android:contentDescription="@null"
            android:layout_marginStart="5.0dip" />
        <TextView
            android:textSize="6.0sp"
            android:textColor="@android:color/black"
            android:gravity="center_vertical"
            android:background="@drawable/intro_preview_address_bar"
            android:layout_width="fill_parent"
            android:layout_height="13.0dip"
            android:text="@string/this_pc"
            android:includeFontPadding="false"
            android:paddingStart="4.0dip"
            android:layout_marginStart="6.0dip" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="6.0dip"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="72.0dip"
            android:layout_height="fill_parent"
            android:paddingStart="4.0dip">
            <LinearLayout
                style="@style/IntroPreviewFmSideRow">
                <ImageView
                    android:src="@drawable/quick_acces"
                    android:contentDescription="@null"
                    style="@style/IntroPreviewFmSideIcon" />
                <TextView
                    android:text="@string/intro_preview_quick_access"
                    style="@style/IntroPreviewFmSideLabel" />
            </LinearLayout>
            <LinearLayout
                style="@style/IntroPreviewFmSideRow">
                <ImageView
                    android:src="@drawable/pc"
                    android:contentDescription="@null"
                    style="@style/IntroPreviewFmSideIcon" />
                <TextView
                    android:text="@string/this_pc"
                    style="@style/IntroPreviewFmSideLabel" />
            </LinearLayout>
            <LinearLayout
                style="@style/IntroPreviewFmSideRow">
                <ImageView
                    android:src="@drawable/local_drive"
                    android:contentDescription="@null"
                    style="@style/IntroPreviewFmSideIcon" />
                <TextView
                    android:text="@string/local_disk_c"
                    style="@style/IntroPreviewFmSideLabel" />
            </LinearLayout>
            <LinearLayout
                style="@style/IntroPreviewFmSideRow">
                <ImageView
                    android:src="@drawable/network"
                    android:contentDescription="@null"
                    style="@style/IntroPreviewFmSideIcon" />
                <TextView
                    android:text="@string/network"
                    style="@style/IntroPreviewFmSideLabel" />
            </LinearLayout>
        </LinearLayout>
        <View
            android:background="#ffd3d3d3"
            android:layout_width="1.0dip"
            android:layout_height="fill_parent" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0"
            android:paddingStart="4.0dip"
            android:paddingEnd="4.0dip">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@id/preview_fm_folder_1"
                    layout="@layout/intro_preview_fm_folder" />
                <include
                    android:id="@id/preview_fm_folder_2"
                    layout="@layout/intro_preview_fm_folder" />
                <include
                    android:id="@id/preview_fm_folder_3"
                    layout="@layout/intro_preview_fm_folder" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@id/preview_fm_folder_4"
                    layout="@layout/intro_preview_fm_folder" />
                <Space
                    android:layout_width="0.0dip"
                    android:layout_height="1.0dip"
                    android:layout_weight="2.0" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/panel_front_rounded"
                android:padding="5.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip">
                <ImageView
                    android:layout_width="26.0dip"
                    android:layout_height="26.0dip"
                    android:src="@drawable/local_drive"
                    android:contentDescription="@null" />
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:layout_marginStart="4.0dip">
                    <TextView
                        android:textSize="6.0sp"
                        android:textColor="@android:color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/local_disk_c"
                        android:includeFontPadding="false" />
                    <ProgressBar
                        android:layout_width="fill_parent"
                        android:layout_height="6.0dip"
                        android:layout_marginTop="2.0dip"
                        android:maxHeight="6.0dip"
                        android:max="100"
                        android:progress="33"
                        android:indeterminate="false"
                        android:progressDrawable="@drawable/progress_limit"
                        android:minHeight="6.0dip"
                        style="?android:progressBarStyleHorizontal" />
                    <TextView
                        android:textSize="5.0sp"
                        android:textColor="@android:color/darker_gray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2.0dip"
                        android:text="@string/intro_preview_drive_detail"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>