<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/rl_main"
        android:background="@drawable/mint_rounded_corner_bg"
        android:paddingLeft="@dimen/normal_margin"
        android:paddingTop="@dimen/normal_margin"
        android:paddingRight="@dimen/normal_margin"
        android:paddingBottom="@dimen/normal_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/normal_margin"
        android:paddingVertical="@dimen/normal_margin">
        <RelativeLayout
            android:layout_width="85.0dip"
            android:layout_height="85.0dip"
            android:layout_marginRight="@dimen/normal_margin">
            <com.juanarton.arcprogressbar.ArcProgressBar
                android:id="@id/arcProgressBar_battery"
                android:layout_width="75.0dip"
                android:layout_height="75.0dip"
                android:layout_centerHorizontal="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:progress="70.0"
                app:progressColor="#ff075c0a"
                app:progressMax="100.0"
                app:progressMin="0.0"
                app:progressWidth="10.0dip"
                app:startAngle="140.0"
                app:sweepAngle="260.0"
                app:trackColor="#ffddefdd"
                app:trackWidth="10.0dip" />
            <ImageView
                android:id="@id/iv_battery"
                android:layout_width="30.0dip"
                android:layout_height="30.0dip"
                android:layout_marginLeft="@dimen/normal_margin"
                android:layout_marginTop="@dimen/normal_margin"
                android:src="@drawable/ic_phone_charging_green"
                android:scaleType="centerInside"
                android:layout_centerInParent="true" />
            <TextView
                android:textSize="14.0sp"
                android:textStyle="bold"
                android:textColor="#ff075c0a"
                android:gravity="center"
                android:id="@id/tv_battery_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/normal_margin"
                android:layout_marginBottom="@dimen/normal_margin"
                android:text="55%"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true" />
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="85.0dip"
            android:layout_height="85.0dip"
            android:layout_marginRight="@dimen/normal_margin">
            <com.juanarton.arcprogressbar.ArcProgressBar
                android:id="@id/arcProgressBar_storage"
                android:layout_width="75.0dip"
                android:layout_height="75.0dip"
                android:layout_centerHorizontal="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:progress="70.0"
                app:progressColor="#ff075c0a"
                app:progressMax="100.0"
                app:progressMin="0.0"
                app:progressWidth="10.0dip"
                app:startAngle="140.0"
                app:sweepAngle="260.0"
                app:trackColor="#ffddefdd"
                app:trackWidth="10.0dip" />
            <ImageView
                android:id="@id/iv_storage"
                android:layout_width="30.0dip"
                android:layout_height="30.0dip"
                android:layout_marginLeft="@dimen/normal_margin"
                android:layout_marginTop="@dimen/normal_margin"
                android:src="@drawable/ic_storage_green"
                android:scaleType="centerInside"
                android:layout_centerInParent="true" />
            <TextView
                android:textSize="14.0sp"
                android:textStyle="bold"
                android:textColor="#ff075c0a"
                android:gravity="center"
                android:id="@id/tv_storage_occupied"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/normal_margin"
                android:layout_marginBottom="@dimen/normal_margin"
                android:text="55%"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true" />
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="85.0dip"
            android:layout_height="85.0dip">
            <com.juanarton.arcprogressbar.ArcProgressBar
                android:id="@id/arcProgressBar_ram"
                android:layout_width="75.0dip"
                android:layout_height="75.0dip"
                android:layout_centerHorizontal="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:progress="70.0"
                app:progressColor="#ff075c0a"
                app:progressMax="100.0"
                app:progressMin="0.0"
                app:progressWidth="10.0dip"
                app:startAngle="140.0"
                app:sweepAngle="260.0"
                app:trackColor="#ffddefdd"
                app:trackWidth="10.0dip" />
            <ImageView
                android:id="@id/iv_ram"
                android:layout_width="30.0dip"
                android:layout_height="30.0dip"
                android:layout_marginLeft="@dimen/normal_margin"
                android:layout_marginTop="@dimen/normal_margin"
                android:src="@drawable/ic_memory_green"
                android:scaleType="centerInside"
                android:layout_centerInParent="true" />
            <TextView
                android:textSize="14.0sp"
                android:textStyle="bold"
                android:textColor="#ff075c0a"
                android:gravity="center"
                android:id="@id/tv_ram_used"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/normal_margin"
                android:layout_marginBottom="@dimen/normal_margin"
                android:text="55%"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true" />
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>