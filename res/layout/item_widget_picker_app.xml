<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/widget_picker_app_row"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/widget_picker_app_head"
        android:background="?android:selectableItemBackground"
        android:layout_width="fill_parent"
        android:layout_height="68.0dip"
        android:paddingStart="16.0dip"
        android:paddingEnd="16.0dip">
        <ImageView
            android:id="@id/widget_picker_app_icon"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:contentDescription="@null" />
        <TextView
            android:textSize="16.0sp"
            android:textColor="#de000000"
            android:ellipsize="end"
            android:id="@id/widget_picker_app_name"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1.0"
            android:layout_marginStart="16.0dip" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="#8a000000"
            android:id="@id/widget_picker_app_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12.0dip" />
        <ImageView
            android:id="@id/widget_picker_app_chevron"
            android:layout_width="20.0dip"
            android:layout_height="20.0dip"
            android:src="@drawable/ic_widget_picker_chevron"
            android:contentDescription="@null"
            android:alpha="0.5"
            android:layout_marginStart="8.0dip" />
    </LinearLayout>
    <View
        android:id="@id/widget_picker_app_divider"
        android:background="#14000000"
        android:layout_width="fill_parent"
        android:layout_height="1.0dip"
        android:layout_marginStart="72.0dip"
        android:layout_marginEnd="16.0dip" />
</LinearLayout>