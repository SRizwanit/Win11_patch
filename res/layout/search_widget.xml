<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:minWidth="200.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <desktop.widgets.SearchBarLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/ll_bg"
        android:background="@drawable/search_bar_background"
        android:paddingLeft="@dimen/medium_margin"
        android:paddingRight="@dimen/medium_margin"
        android:layout_width="fill_parent"
        android:layout_height="45.0dip">
        <ImageView
            android:id="@id/iv_search_btn"
            android:padding="@dimen/medium_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/search_google"
            android:layout_marginStart="2.0dip" />
        <TextView
            android:textSize="12.0sp"
            android:textColor="@android:color/darker_gray"
            android:gravity="end|center"
            android:id="@id/tv_ok_google"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0" />
        <ImageView
            android:id="@id/iv_search_ai"
            android:padding="@dimen/medium_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_search_ai" />
        <ImageView
            android:id="@id/iv_voice_search"
            android:padding="@dimen/medium_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_mic" />
        <ImageView
            android:id="@id/iv_lense"
            android:padding="@dimen/medium_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_lens"
            android:layout_marginEnd="2.0dip" />
    </desktop.widgets.SearchBarLayout>
</LinearLayout>