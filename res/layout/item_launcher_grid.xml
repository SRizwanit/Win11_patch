<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8.0dip"
    app:cardCornerRadius="12.0dip"
    app:cardElevation="4.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@id/launcher_thumbnail"
                android:background="#ffe0e0e0"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="H,9:16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="vertical"
            android:padding="12.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16.0sp"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:ellipsize="end"
                android:id="@id/launcher_name"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLines="1" />
            <TextView
                android:textSize="12.0sp"
                android:textColor="#ff757575"
                android:id="@id/launcher_category"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip">
                <ImageView
                    android:layout_width="14.0dip"
                    android:layout_height="14.0dip"
                    android:src="@drawable/star_black"
                    app:tint="#ffffc107" />
                <TextView
                    android:textSize="12.0sp"
                    android:textColor="#ff757575"
                    android:id="@id/launcher_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.5"
                    android:layout_marginStart="4.0dip" />
                <Space
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0" />
                <com.google.android.material.button.MaterialButton
                    android:textSize="12.0sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_gravity="center_vertical"
                    android:id="@id/install_button"
                    android:layout_width="wrap_content"
                    android:layout_height="36.0dip"
                    android:minWidth="80.0dip"
                    android:minHeight="0.0dip"
                    android:text="@string/install_caps"
                    android:insetTop="0.0dip"
                    android:insetBottom="0.0dip"
                    android:paddingStart="12.0dip"
                    android:paddingEnd="12.0dip"
                    android:backgroundTint="#ff2196f3"
                    app:cornerRadius="18.0dip"
                    app:rippleColor="#40ffffff"
                    style="@style/Widget.MaterialComponents.Button" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>