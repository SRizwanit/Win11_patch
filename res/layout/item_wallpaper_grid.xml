<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:padding="@dimen/medium_margin"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="fill_parent"
        android:layout_height="230.0dip"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="12.0dip"
        app:cardElevation="0.0dip">
        <FrameLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <ImageView
                android:id="@id/iv_wallpaper"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:scaleType="centerCrop" />
            <ImageView
                android:layout_gravity="end|center|top"
                android:id="@id/iv_applied_indicator"
                android:background="@drawable/circle_green_bg"
                android:padding="@dimen/small_margin"
                android:visibility="gone"
                android:layout_width="20.0dip"
                android:layout_height="20.0dip"
                android:layout_margin="8.0dip"
                android:src="@drawable/ic_theme_applied" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="14.0sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@id/tv_wallpaper_name"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:singleLine="true"
        android:drawablePadding="@dimen/medium_margin" />
</LinearLayout>