<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/ll_backup_restore"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/normal_margin"
    android:layout_marginRight="@dimen/normal_margin"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/ll_backup"
        android:background="@drawable/ripple_quick_access_item_bg"
        android:padding="@dimen/margin_15dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14.0sp"
            android:textColor="@android:color/black"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/backup_data"
            android:drawableLeft="@drawable/backup_icon"
            android:drawablePadding="@dimen/normal_margin"
            android:layout_weight="1.0" />
        <ImageView
            android:id="@id/iv_pro_backup"
            android:layout_width="32.0dip"
            android:layout_height="16.0dip"
            android:src="@drawable/pro_mini"
            android:layout_marginEnd="8.0dip" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/tv_restore"
        android:background="@drawable/ripple_quick_access_item_bg"
        android:padding="@dimen/margin_15dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14.0sp"
            android:textColor="@android:color/black"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/restore_data"
            android:drawableLeft="@drawable/restore_icon"
            android:drawablePadding="@dimen/normal_margin"
            android:layout_weight="1.0" />
        <ImageView
            android:id="@id/iv_pro_restore"
            android:layout_width="32.0dip"
            android:layout_height="16.0dip"
            android:src="@drawable/pro_mini"
            android:layout_marginEnd="8.0dip" />
    </LinearLayout>
</LinearLayout>