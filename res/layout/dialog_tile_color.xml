<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:paddingTop="20.0dip"
    android:paddingBottom="4.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24.0dip"
    android:paddingEnd="24.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="20.0sp"
        android:textColor="#de000000"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="@string/tile_color_title"
        android:fontFamily="sans-serif-medium" />
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/tile_color_mode"
        android:padding="3.0dip"
        android:layout_width="fill_parent"
        android:layout_height="40.0dip"
        android:layout_marginTop="16.0dip">
        <TextView
            android:textSize="14.0sp"
            android:gravity="center"
            android:id="@id/tile_color_mode_solid"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:text="@string/tile_color_solid"
            android:layout_weight="1.0" />
        <TextView
            android:textSize="14.0sp"
            android:gravity="center"
            android:id="@id/tile_color_mode_gradient"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:text="@string/tile_color_gradient"
            android:layout_weight="1.0" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20.0dip"
        android:baselineAligned="false">
        <FrameLayout
            android:id="@id/tile_color_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:layout_marginStart="24.0dip">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@id/tile_color_swatch_start_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <View
                    android:id="@id/tile_color_swatch_start"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="48.0dip"
                    android:layout_height="48.0dip" />
                <TextView
                    android:textSize="12.0sp"
                    android:textColor="#99000000"
                    android:id="@id/tile_color_swatch_start_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6.0dip"
                    android:text="@string/tile_color_color" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@id/tile_color_swatch_end_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24.0dip">
                <View
                    android:id="@id/tile_color_swatch_end"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="48.0dip"
                    android:layout_height="48.0dip" />
                <TextView
                    android:textSize="12.0sp"
                    android:textColor="#99000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6.0dip"
                    android:text="@string/tile_color_end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/tile_color_angle_row"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16.0dip">
        <TextView
            android:textSize="14.0sp"
            android:textColor="#de000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tile_color_angle" />
        <SeekBar
            android:id="@id/tile_color_angle"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:max="359"
            android:layout_weight="1.0"
            android:layout_marginStart="8.0dip" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="#de000000"
            android:gravity="end"
            android:id="@id/tile_color_angle_value"
            android:layout_width="44.0dip"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>