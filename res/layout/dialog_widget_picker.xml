<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <View
        android:layout_gravity="center_horizontal"
        android:background="@drawable/widget_picker_handle"
        android:layout_width="36.0dip"
        android:layout_height="4.0dip"
        android:layout_marginTop="10.0dip" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14.0dip"
        android:layout_marginStart="24.0dip"
        android:layout_marginEnd="20.0dip">
        <TextView
            android:textSize="22.0sp"
            android:textColor="#e6000000"
            android:ellipsize="end"
            android:id="@id/widget_picker_title"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/widgets"
            android:singleLine="true"
            android:layout_weight="1.0"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="#ffffffff"
            android:gravity="center_vertical"
            android:id="@id/widget_picker_more"
            android:background="@drawable/widget_picker_more_bg"
            android:layout_width="wrap_content"
            android:layout_height="36.0dip"
            android:text="@string/more_widgets"
            android:singleLine="true"
            android:drawablePadding="8.0dip"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="10.0dip"
            android:paddingEnd="16.0dip"
            android:layout_marginStart="12.0dip" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/widget_picker_watch_faces"
        android:background="@drawable/widget_picker_watch_faces_bg"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="fill_parent"
        android:layout_height="60.0dip"
        android:layout_marginTop="14.0dip"
        android:paddingStart="14.0dip"
        android:paddingEnd="14.0dip"
        android:layout_marginStart="20.0dip"
        android:layout_marginEnd="20.0dip">
        <ImageView
            android:background="@drawable/widget_picker_watch_faces_icon_bg"
            android:padding="7.0dip"
            android:layout_width="36.0dip"
            android:layout_height="36.0dip"
            android:src="@drawable/wf_ic_watch"
            android:contentDescription="@null" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:layout_marginStart="12.0dip">
            <TextView
                android:textSize="15.0sp"
                android:textColor="#ffffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/watch_faces"
                android:singleLine="true"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:textSize="12.0sp"
                android:textColor="#b3ffffff"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/watch_faces_subtitle"
                android:singleLine="true" />
        </LinearLayout>
        <TextView
            android:textSize="26.0sp"
            android:textColor="#b3ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/widget_picker_search_bg"
        android:layout_width="fill_parent"
        android:layout_height="44.0dip"
        android:layout_marginTop="14.0dip"
        android:paddingStart="14.0dip"
        android:paddingEnd="8.0dip"
        android:layout_marginStart="20.0dip"
        android:layout_marginEnd="20.0dip">
        <ImageView
            android:layout_width="20.0dip"
            android:layout_height="20.0dip"
            android:src="@drawable/search_icon"
            android:contentDescription="@null"
            android:alpha="0.55" />
        <EditText
            android:textSize="15.0sp"
            android:textColor="#de000000"
            android:textColorHint="#61000000"
            android:id="@id/widget_picker_search"
            android:background="@null"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:hint="@string/widget_picker_search_hint"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_weight="1.0"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:layout_marginStart="10.0dip"
            android:importantForAutofill="no" />
        <ImageView
            android:id="@id/widget_picker_clear"
            android:background="?android:selectableItemBackgroundBorderless"
            android:padding="8.0dip"
            android:visibility="gone"
            android:layout_width="32.0dip"
            android:layout_height="32.0dip"
            android:src="@drawable/ic_app_picker_clear"
            android:contentDescription="@string/cancel" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@id/widget_picker_list"
            android:paddingTop="8.0dip"
            android:paddingBottom="24.0dip"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:paddingStart="16.0dip"
            android:paddingEnd="16.0dip" />
        <ProgressBar
            android:layout_gravity="center"
            android:id="@id/widget_picker_progress"
            android:layout_width="32.0dip"
            android:layout_height="32.0dip" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="#61000000"
            android:layout_gravity="center"
            android:id="@id/widget_picker_empty"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_picker_empty" />
    </FrameLayout>
</LinearLayout>