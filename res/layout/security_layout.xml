<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:id="@id/sv_security"
    android:scrollbars="none"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_marginLeft="@dimen/normal_margin"
    android:layout_marginRight="@dimen/normal_margin"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/ll_security"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/ll_pin_hide_app"
            android:background="@drawable/ripple_quick_access_item_bg"
            android:padding="@dimen/margin_15dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14.0sp"
                android:textColor="@android:color/black"
                android:id="@id/tv_pin_hide_app"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/set_pin"
                android:drawableLeft="@drawable/pin"
                android:drawablePadding="@dimen/normal_margin"
                android:layout_weight="1.0" />
            <ImageView
                android:id="@id/iv_pro_pin_hide_app"
                android:layout_width="32.0dip"
                android:layout_height="16.0dip"
                android:src="@drawable/pro_mini"
                android:layout_marginEnd="8.0dip" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/ll_lock_screen"
            android:background="@drawable/ripple_quick_access_item_bg"
            android:padding="@dimen/margin_15dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14.0sp"
                android:textColor="@android:color/black"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/lock_screen"
                android:drawableLeft="@drawable/lock_screen"
                android:drawablePadding="@dimen/normal_margin"
                android:layout_weight="1.0" />
        </LinearLayout>
        <TextView
            android:textSize="14.0sp"
            android:textColor="@android:color/black"
            android:gravity="center_vertical"
            android:id="@id/tv_consent"
            android:padding="@dimen/margin_15dp"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/data_protection_consent"
            android:drawableLeft="@drawable/privacy"
            android:drawablePadding="@dimen/normal_margin" />
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/margin_15dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14.0sp"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:id="@id/tv_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/show_hidden_apps"
                android:drawableLeft="@drawable/show_icon"
                android:drawablePadding="@dimen/normal_margin" />
            <ToggleButton
                android:id="@id/cb_hide_apps"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/settings_margin"
                android:layout_marginTop="@dimen/medium_margin"
                android:button="@drawable/toggle_selector"
                android:textOn=""
                android:textOff=""
                android:minWidth="0.0dip"
                android:minHeight="0.0dip" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/margin_15dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14.0sp"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:id="@id/tv_lock_file_manager"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lock_file_manager"
                android:drawableLeft="@drawable/lock_file_manager"
                android:drawablePadding="@dimen/normal_margin"
                android:layout_centerVertical="true" />
            <ToggleButton
                android:id="@id/cb_lock_file_manager"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/settings_margin"
                android:layout_marginTop="@dimen/medium_margin"
                android:button="@drawable/toggle_selector"
                android:textOn=""
                android:textOff=""
                android:minWidth="0.0dip"
                android:minHeight="0.0dip" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/margin_15dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14.0sp"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enable_launcher_lock"
                android:drawableLeft="@drawable/launcher_lock"
                android:drawablePadding="@dimen/normal_margin" />
            <ToggleButton
                android:id="@id/cb_lock_launcher_enabled"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/settings_margin"
                android:layout_marginTop="@dimen/medium_margin"
                android:button="@drawable/toggle_selector"
                android:textOn=""
                android:textOff=""
                android:minWidth="0.0dip"
                android:minHeight="0.0dip" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>