<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/noti_main_bg"
    android:background="@drawable/trans_white_rounded_corner_bg"
    android:padding="10.0dip"
    android:layout_width="fill_parent"
    android:layout_height="120.0dip"
    android:layout_marginTop="10.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/iv_icon"
        android:padding="@dimen/medium_margin"
        android:layout_width="30.0dip"
        android:layout_height="30.0dip"
        android:src="@drawable/default_blue"
        android:layout_alignParentRight="true" />
    <com.centsol.w10launcher.panel.WaveformBarsView
        android:id="@id/noti_media_wave"
        android:visibility="gone"
        android:layout_width="20.0dip"
        android:layout_height="16.0dip"
        android:layout_marginTop="7.0dip"
        android:layout_marginRight="4.0dip"
        android:layout_toLeftOf="@id/iv_icon"
        android:layout_alignTop="@id/iv_icon"
        android:layout_marginEnd="4.0dip"
        android:layout_toStartOf="@id/iv_icon" />
    <ImageView
        android:id="@id/civ_senderIcon"
        android:background="@drawable/rect_music"
        android:layout_width="40.0dip"
        android:layout_height="40.0dip"
        android:src="@drawable/music_play"
        android:clipToOutline="true" />
    <TextView
        android:textSize="15.0sp"
        android:textColor="@android:color/black"
        android:gravity="center_vertical"
        android:id="@id/tv_app_title"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/medium_margin"
        android:layout_marginRight="@dimen/medium_margin"
        android:layout_marginBottom="@dimen/medium_margin"
        android:text="@string/sound"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_toRightOf="@id/iv_icon"
        android:layout_alignTop="@id/iv_icon"
        android:layout_alignBottom="@id/iv_icon"
        android:layout_marginStart="@dimen/medium_margin"
        android:layout_marginEnd="@dimen/medium_margin"
        android:layout_toEndOf="@id/iv_icon" />
    <TextView
        android:textSize="12.0sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:id="@id/tv_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5.0dip"
        android:layout_marginBottom="@dimen/medium_margin"
        android:text="@string/sound"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_toRightOf="@id/civ_senderIcon"
        android:layout_marginStart="@dimen/medium_margin"
        android:layout_marginEnd="@dimen/medium_margin"
        android:layout_toStartOf="@id/noti_media_wave"
        android:layout_toEndOf="@id/civ_senderIcon" />
    <TextView
        android:textSize="10.0sp"
        android:textColor="@android:color/black"
        android:id="@id/sub_tv_text"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/medium_margin"
        android:layout_marginBottom="@dimen/medium_margin"
        android:text="@string/sound"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_toRightOf="@id/civ_senderIcon"
        android:layout_below="@id/tv_text"
        android:layout_marginStart="@dimen/medium_margin"
        android:layout_marginEnd="@dimen/medium_margin"
        android:layout_toStartOf="@id/noti_media_wave"
        android:layout_toEndOf="@id/civ_senderIcon" />
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/ll_progress"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/sub_tv_text">
        <TextView
            android:textSize="12.0sp"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@id/tv_progress"
            android:layout_width="40.0dip"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/medium_margin"
            android:text="0:45" />
        <ProgressBar
            android:id="@id/progressBar"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:maxHeight="@dimen/medium_margin"
            android:progressDrawable="@drawable/progess_bar_bg"
            android:minHeight="@dimen/medium_margin"
            android:layout_weight="1.0"
            style="?android:progressBarStyleHorizontal" />
        <TextView
            android:textSize="12.0sp"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@id/tv_duration"
            android:layout_width="40.0dip"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/medium_margin"
            android:text="5:45" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/notification_top_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/ll_progress">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@id/notification_action_container"
            android:paddingTop="10.0dip"
            android:paddingBottom="5.0dip"
            android:layout_width="fill_parent"
            android:layout_height="40.0dip" />
    </LinearLayout>
</RelativeLayout>