<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/rowbg"
    android:background="@drawable/panel_front_rounded"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/lyt_book"
        android:padding="@dimen/small_margin"
        android:layout_width="110.0dip"
        android:layout_height="110.0dip">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:id="@id/explorer_resIcon"
                android:layout_width="50.0dip"
                android:layout_height="50.0dip"
                android:src="@drawable/filetype_generic"
                android:scaleType="centerInside" />
            <TextView
                android:textSize="12.0sp"
                android:textColor="@android:color/black"
                android:id="@id/explorer_resName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true" />
            <TextView
                android:textSize="@dimen/fm_text_small"
                android:textColor="@android:color/black"
                android:id="@id/explorer_resMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:singleLine="true" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@id/file_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            app:buttonTint="@android:color/black" />
    </RelativeLayout>
</RelativeLayout>