<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:id="@id/sv_personalization"
    android:scrollbars="none"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_marginLeft="@dimen/normal_margin"
    android:layout_marginRight="@dimen/normal_margin"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/ll_personalization"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14.0sp"
            android:textColor="@android:color/black"
            android:gravity="center_vertical"
            android:id="@id/tv_remove_ads"
            android:background="@drawable/ripple_quick_access_item_bg"
            android:padding="@dimen/margin_15dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/remove_ads"
            android:drawableLeft="@drawable/remove_ads_settings"
            android:drawablePadding="@dimen/normal_margin" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="@android:color/black"
            android:gravity="center_vertical"
            android:id="@id/tv_wallpapers"
            android:background="@drawable/ripple_quick_access_item_bg"
            android:padding="@dimen/margin_15dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/wallpapers"
            android:drawableLeft="@drawable/background"
            android:drawablePadding="@dimen/normal_margin" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="@android:color/black"
            android:gravity="center_vertical"
            android:id="@id/tv_select_theme"
            android:background="@drawable/ripple_quick_access_item_bg"
            android:padding="@dimen/margin_15dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme"
            android:drawableLeft="@drawable/theme"
            android:drawablePadding="@dimen/normal_margin" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="@android:color/black"
            android:gravity="center_vertical"
            android:id="@id/tv_grid_view"
            android:background="@drawable/ripple_quick_access_item_bg"
            android:padding="@dimen/margin_15dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/desktop_grid_size"
            android:drawableLeft="@drawable/grid_icon"
            android:drawablePadding="@dimen/normal_margin" />
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/margin_15dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14.0sp"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hide_taskbar_icons"
                android:drawableLeft="@drawable/hide_icon"
                android:drawablePadding="@dimen/normal_margin" />
            <ToggleButton
                android:id="@id/cb_hide_taskbar_icons"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/settings_margin"
                android:layout_marginTop="@dimen/medium_margin"
                android:button="@drawable/toggle_selector"
                android:textOn=""
                android:textOff=""
                android:minWidth="0.0dip"
                android:minHeight="0.0dip" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/margin_15dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14.0sp"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enable_motion_effect"
                android:drawableLeft="@drawable/ic_motion_effect"
                android:drawablePadding="@dimen/normal_margin" />
            <ToggleButton
                android:id="@id/cb_motion_effect"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/settings_margin"
                android:layout_marginTop="@dimen/medium_margin"
                android:button="@drawable/toggle_selector"
                android:textOn=""
                android:textOff=""
                android:minWidth="0.0dip"
                android:minHeight="0.0dip" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>