<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@id/preview_root"
    android:background="@drawable/intro_preview_frame"
    android:padding="4.0dip"
    android:layout_width="235.0dip"
    android:layout_height="460.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/preview_screen"
        android:background="@drawable/intro_preview_screen"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <FrameLayout
            android:id="@id/preview_desktop"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.0">
            <ImageView
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:src="@drawable/background_wallpaper"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/preview_desktop_items"
                android:padding="6.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/search_widget_bg"
                    android:layout_width="fill_parent"
                    android:layout_height="22.0dip"
                    android:layout_marginBottom="4.0dip"
                    android:paddingStart="7.0dip"
                    android:paddingEnd="7.0dip"
                    android:layout_marginStart="2.0dip"
                    android:layout_marginEnd="2.0dip">
                    <ImageView
                        android:layout_width="11.0dip"
                        android:layout_height="11.0dip"
                        android:src="@drawable/search_google"
                        android:contentDescription="@null" />
                    <Space
                        android:layout_width="0.0dip"
                        android:layout_height="1.0dip"
                        android:layout_weight="1.0" />
                    <ImageView
                        android:layout_width="10.0dip"
                        android:layout_height="10.0dip"
                        android:src="@drawable/ic_lens"
                        android:contentDescription="@null"
                        android:layout_marginEnd="6.0dip"
                        app:tint="#ff5f6368" />
                    <ImageView
                        android:layout_width="10.0dip"
                        android:layout_height="10.0dip"
                        android:src="@drawable/ic_mic"
                        android:contentDescription="@null"
                        app:tint="#ff5f6368" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <include
                                android:id="@id/preview_this_pc"
                                layout="@layout/intro_preview_tile" />
                            <include
                                android:id="@id/preview_tile_user"
                                layout="@layout/intro_preview_tile" />
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <include
                                android:id="@id/preview_tile_bin"
                                layout="@layout/intro_preview_tile" />
                            <include
                                android:id="@id/preview_tile_wallpapers"
                                layout="@layout/intro_preview_tile" />
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <include
                                android:id="@id/preview_tile_games"
                                layout="@layout/intro_preview_tile" />
                            <include
                                android:id="@id/preview_tile_theme"
                                layout="@layout/intro_preview_tile" />
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <include
                                android:id="@id/preview_tile_widgets"
                                layout="@layout/intro_preview_tile" />
                        </LinearLayout>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="0.0dip"
                        android:layout_height="84.0dip"
                        android:src="@drawable/analog_clock"
                        android:scaleType="fitCenter"
                        android:layout_weight="1.0"
                        android:contentDescription="@null"
                        android:layout_marginStart="6.0dip" />
                </LinearLayout>
            </LinearLayout>
            <include
                layout="@layout/intro_preview_start_menu" />
            <include
                layout="@layout/intro_preview_action_center" />
            <include
                layout="@layout/intro_preview_file_manager" />
            <include
                layout="@layout/intro_preview_widgets" />
            <include
                layout="@layout/intro_preview_customize" />
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@id/preview_menu"
                android:background="@drawable/w11_menu_surface"
                android:padding="3.0dip"
                android:visibility="gone"
                android:layout_width="180.0dip"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <include
                        android:id="@id/preview_menu_1"
                        layout="@layout/intro_preview_menu_cell" />
                    <include
                        android:id="@id/preview_menu_2"
                        layout="@layout/intro_preview_menu_cell" />
                    <include
                        android:id="@id/preview_menu_3"
                        layout="@layout/intro_preview_menu_cell" />
                    <include
                        android:id="@id/preview_menu_4"
                        layout="@layout/intro_preview_menu_cell" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <include
                        android:id="@id/preview_menu_5"
                        layout="@layout/intro_preview_menu_cell" />
                    <include
                        android:id="@id/preview_menu_6"
                        layout="@layout/intro_preview_menu_cell" />
                    <include
                        android:id="@id/preview_menu_7"
                        layout="@layout/intro_preview_menu_cell" />
                    <include
                        android:id="@id/preview_menu_8"
                        layout="@layout/intro_preview_menu_cell" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <include
                        android:id="@id/preview_menu_9"
                        layout="@layout/intro_preview_menu_cell" />
                    <include
                        android:id="@id/preview_menu_10"
                        layout="@layout/intro_preview_menu_cell" />
                    <include
                        android:id="@id/preview_menu_11"
                        layout="@layout/intro_preview_menu_cell" />
                    <include
                        android:id="@id/preview_menu_12"
                        layout="@layout/intro_preview_menu_cell" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/preview_taskbar"
            android:background="@drawable/intro_preview_taskbar"
            android:layout_width="fill_parent"
            android:layout_height="36.0dip"
            android:paddingStart="5.0dip"
            android:paddingEnd="5.0dip">
            <ImageView
                android:id="@id/preview_start"
                android:layout_width="19.0dip"
                android:layout_height="19.0dip"
                android:src="@drawable/start_n"
                android:contentDescription="@null" />
            <ImageView
                android:layout_width="16.0dip"
                android:layout_height="16.0dip"
                android:src="@drawable/cortana_white"
                android:contentDescription="@null"
                android:layout_marginStart="7.0dip" />
            <ImageView
                android:layout_width="18.0dip"
                android:layout_height="18.0dip"
                android:src="@drawable/google_chrome"
                android:contentDescription="@null"
                android:layout_marginStart="7.0dip" />
            <ImageView
                android:layout_width="18.0dip"
                android:layout_height="18.0dip"
                android:src="@drawable/sms"
                android:contentDescription="@null"
                android:layout_marginStart="7.0dip" />
            <ImageView
                android:layout_width="18.0dip"
                android:layout_height="18.0dip"
                android:src="@drawable/phone"
                android:contentDescription="@null"
                android:layout_marginStart="7.0dip" />
            <Space
                android:layout_width="0.0dip"
                android:layout_height="1.0dip"
                android:layout_weight="1.0" />
            <ImageView
                android:layout_width="11.0dip"
                android:layout_height="11.0dip"
                android:src="@drawable/up_arrow_white"
                android:contentDescription="@null" />
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6.0dip"
                android:layout_marginEnd="6.0dip">
                <TextView
                    android:textSize="8.0sp"
                    android:textColor="@android:color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/intro_preview_time"
                    android:includeFontPadding="false" />
                <TextView
                    android:textSize="8.0sp"
                    android:textColor="@android:color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/intro_preview_date"
                    android:includeFontPadding="false" />
            </LinearLayout>
            <ImageView
                android:id="@id/preview_action_center"
                android:layout_width="16.0dip"
                android:layout_height="16.0dip"
                android:src="@drawable/noti_normal"
                android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@id/preview_ring_1"
        android:background="@drawable/intro_spotlight"
        android:visibility="gone"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip" />
    <View
        android:id="@id/preview_ring_2"
        android:background="@drawable/intro_spotlight"
        android:visibility="gone"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip" />
    <TextView
        android:textSize="9.0sp"
        android:textStyle="bold"
        android:textColor="#ff1a1a1a"
        android:gravity="center"
        android:id="@id/preview_badge_1"
        android:background="@drawable/intro_badge_bg"
        android:visibility="gone"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:text="@string/intro_step_one"
        android:includeFontPadding="false" />
    <TextView
        android:textSize="9.0sp"
        android:textStyle="bold"
        android:textColor="#ff1a1a1a"
        android:gravity="center"
        android:id="@id/preview_badge_2"
        android:background="@drawable/intro_badge_bg"
        android:visibility="gone"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:text="@string/intro_step_two"
        android:includeFontPadding="false" />
</FrameLayout>