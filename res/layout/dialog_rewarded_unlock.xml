<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:theme="@style/AlertDialogCustom"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16.0dip"
    app:cardBackgroundColor="#ffffffff"
    app:cardCornerRadius="28.0dip"
    app:cardElevation="0.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:padding="20.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@id/iv_unlock_close"
                android:background="?selectableItemBackgroundBorderless"
                android:padding="4.0dip"
                android:layout_width="32.0dip"
                android:layout_height="32.0dip"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="@null"
                android:layout_alignParentEnd="true"
                app:tint="#ff7a8da6" />
            <TextView
                android:textSize="18.0sp"
                android:textStyle="bold"
                android:textColor="#ff003380"
                android:ellipsize="end"
                android:id="@id/tv_unlock_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:drawablePadding="8.0dip"
                android:layout_centerVertical="true"
                android:drawableStart="@drawable/pro_mini"
                android:layout_toStartOf="@id/iv_unlock_close" />
        </RelativeLayout>
        <TextView
            android:textSize="14.0sp"
            android:textColor="#ff7a8da6"
            android:id="@id/tv_unlock_message"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12.0dip"
            android:lineSpacingExtra="2.0dip" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/ll_get_premium"
            android:background="@drawable/bg_premium_pill"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="64.0dip"
            android:layout_marginTop="20.0dip"
            android:paddingStart="5.0dip"
            android:paddingEnd="12.0dip">
            <FrameLayout
                android:background="@drawable/bg_premium_crown_ring"
                android:layout_width="52.0dip"
                android:layout_height="52.0dip">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="32.0dip"
                    android:layout_height="32.0dip"
                    android:src="@drawable/ic_premium_crown"
                    android:contentDescription="@null" />
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="12.0dip"
                android:layout_marginEnd="8.0dip">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="18.0sp"
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rewarded_unlock_get" />
                    <TextView
                        android:textSize="18.0sp"
                        android:textStyle="bold"
                        android:textColor="#ffffc107"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rewarded_unlock_premium"
                        android:layout_marginStart="5.0dip" />
                </LinearLayout>
                <TextView
                    android:textSize="13.0sp"
                    android:textColor="#ffe6e9ef"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rewarded_unlock_premium_subtitle" />
            </LinearLayout>
            <FrameLayout
                android:background="@drawable/bg_premium_chevron_circle"
                android:layout_width="36.0dip"
                android:layout_height="36.0dip">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="20.0dip"
                    android:layout_height="20.0dip"
                    android:src="@drawable/ic_premium_chevron"
                    android:contentDescription="@null" />
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/ll_watch_video"
            android:background="@drawable/bg_watch_pill"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="64.0dip"
            android:layout_marginTop="12.0dip"
            android:paddingStart="5.0dip"
            android:paddingEnd="12.0dip">
            <FrameLayout
                android:background="@drawable/bg_watch_icon_ring"
                android:layout_width="52.0dip"
                android:layout_height="52.0dip">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="34.0dip"
                    android:layout_height="34.0dip"
                    android:src="@drawable/ic_watch_clapper"
                    android:contentDescription="@null" />
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="12.0dip"
                android:layout_marginEnd="8.0dip">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16.0sp"
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:id="@id/tv_watch_video"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="2" />
                    <TextView
                        android:textSize="16.0sp"
                        android:textStyle="bold"
                        android:textColor="#ff8f7cff"
                        android:id="@id/tv_watch_video_accent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5.0dip" />
                </LinearLayout>
                <TextView
                    android:textSize="13.0sp"
                    android:textColor="#ff9aa3b8"
                    android:id="@id/tv_unlock_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <FrameLayout
                android:background="@drawable/bg_watch_play_circle"
                android:layout_width="36.0dip"
                android:layout_height="36.0dip">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="18.0dip"
                    android:layout_height="18.0dip"
                    android:src="@drawable/ic_watch_play"
                    android:contentDescription="@null" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>