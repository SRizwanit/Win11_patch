<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/ll_system"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14.0sp"
            android:textColor="@android:color/black"
            android:gravity="center_vertical"
            android:id="@id/tv_default_launcher_settings"
            android:background="@drawable/ripple_quick_access_item_bg"
            android:padding="@dimen/margin_15dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/default_launcher_settings"
            android:drawablePadding="@dimen/normal_margin"
            app:drawableLeftCompat="@drawable/launcher_settings_icon" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="@android:color/black"
            android:gravity="center_vertical"
            android:id="@id/tv_system_settings"
            android:background="@drawable/ripple_quick_access_item_bg"
            android:padding="@dimen/margin_15dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/system_settings"
            android:drawablePadding="@dimen/normal_margin"
            app:drawableLeftCompat="@drawable/settings_icon" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="@android:color/black"
            android:gravity="center_vertical"
            android:id="@id/tv_notification_settings"
            android:background="@drawable/ripple_quick_access_item_bg"
            android:padding="@dimen/margin_15dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/notification_settings"
            android:drawablePadding="@dimen/normal_margin"
            app:drawableLeftCompat="@drawable/notification_settings" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="@android:color/black"
            android:gravity="center_vertical"
            android:id="@id/tv_nav_keys"
            android:background="@drawable/ripple_quick_access_item_bg"
            android:padding="@dimen/margin_15dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/show_status_bar_amp_nav_keys"
            android:drawablePadding="@dimen/normal_margin"
            app:drawableLeftCompat="@drawable/nav_keys_icon" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="@android:color/black"
            android:gravity="center_vertical"
            android:id="@id/tv_date_format"
            android:background="@drawable/ripple_quick_access_item_bg"
            android:padding="@dimen/margin_15dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/date_format"
            android:drawablePadding="@dimen/normal_margin"
            app:drawableLeftCompat="@drawable/calendar_icon" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/ll_page_animation"
            android:background="@drawable/ripple_quick_access_item_bg"
            android:padding="@dimen/margin_15dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14.0sp"
                android:textColor="@android:color/black"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/desktop_page_animation"
                android:drawablePadding="@dimen/normal_margin"
                android:layout_weight="1.0"
                app:drawableLeftCompat="@drawable/icon_transition" />
            <ImageView
                android:id="@id/iv_pro_page_animation"
                android:layout_width="32.0dip"
                android:layout_height="16.0dip"
                android:src="@drawable/pro_mini"
                android:layout_marginEnd="8.0dip" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/ll_particle_effect"
            android:background="@drawable/ripple_quick_access_item_bg"
            android:padding="@dimen/margin_15dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14.0sp"
                android:textColor="@android:color/black"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/particle_effect"
                android:drawablePadding="@dimen/normal_margin"
                android:layout_weight="1.0"
                app:drawableLeftCompat="@drawable/icon_remove_icon_aniamtion" />
            <ImageView
                android:id="@id/iv_pro_particle_effect"
                android:layout_width="32.0dip"
                android:layout_height="16.0dip"
                android:src="@drawable/pro_mini"
                android:layout_marginEnd="8.0dip" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/ll_desktop_tile_style"
            android:background="@drawable/ripple_quick_access_item_bg"
            android:padding="@dimen/margin_15dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14.0sp"
                android:textColor="@android:color/black"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/desktop_tile_style"
                android:drawablePadding="@dimen/normal_margin"
                android:layout_weight="1.0"
                app:drawableLeftCompat="@drawable/tiles_colors" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/margin_15dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14.0sp"
                android:textColor="@android:color/black"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notification_alerts"
                android:drawablePadding="@dimen/normal_margin"
                app:drawableLeftCompat="@drawable/notification_alert" />
            <ToggleButton
                android:id="@id/cb_push_noti"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/settings_margin"
                android:layout_marginTop="@dimen/medium_margin"
                android:button="@drawable/toggle_selector"
                android:textOn=""
                android:textOff=""
                android:minWidth="0.0dip"
                android:minHeight="0.0dip" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/margin_15dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14.0sp"
                android:textColor="@android:color/black"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/launch_at_phone_startup"
                android:drawablePadding="@dimen/normal_margin"
                app:drawableLeftCompat="@drawable/launcher_phone" />
            <ToggleButton
                android:id="@id/cb_start_launcher"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/settings_margin"
                android:layout_marginTop="@dimen/medium_margin"
                android:button="@drawable/toggle_selector"
                android:textOn=""
                android:textOff=""
                android:minWidth="0.0dip"
                android:minHeight="0.0dip" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/ll_debug_free_user"
            android:padding="@dimen/margin_15dp"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14.0sp"
                android:textColor="@android:color/black"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/debug_simulate_free_user"
                android:drawablePadding="@dimen/normal_margin"
                app:drawableLeftCompat="@drawable/launcher_phone" />
            <TextView
                android:textSize="12.0sp"
                android:textColor="@android:color/darker_gray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/settings_margin"
                android:layout_marginTop="@dimen/small_margin"
                android:text="@string/debug_simulate_free_user_hint" />
            <ToggleButton
                android:id="@id/cb_debug_free_user"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/settings_margin"
                android:layout_marginTop="@dimen/medium_margin"
                android:button="@drawable/toggle_selector"
                android:textOn=""
                android:textOff=""
                android:minWidth="0.0dip"
                android:minHeight="0.0dip" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>