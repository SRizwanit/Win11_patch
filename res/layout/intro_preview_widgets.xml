<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@id/preview_widgets"
    android:background="@drawable/intro_preview_sheet"
    android:paddingTop="5.0dip"
    android:visibility="gone"
    android:layout_width="fill_parent"
    android:layout_height="350.0dip"
    android:paddingStart="8.0dip"
    android:paddingEnd="8.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <View
        android:layout_gravity="center_horizontal"
        android:background="@drawable/widget_picker_handle"
        android:layout_width="22.0dip"
        android:layout_height="2.0dip" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7.0dip">
        <TextView
            android:textSize="12.0sp"
            android:textStyle="bold"
            android:textColor="#ff101318"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/widgets"
            android:includeFontPadding="false"
            android:layout_weight="1.0" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/widget_picker_more_bg"
            android:layout_width="wrap_content"
            android:layout_height="17.0dip"
            android:paddingStart="5.0dip"
            android:paddingEnd="7.0dip">
            <ImageView
                android:layout_width="10.0dip"
                android:layout_height="10.0dip"
                android:src="@drawable/widgets_desktop_icon"
                android:contentDescription="@null" />
            <TextView
                android:textSize="7.0sp"
                android:textColor="#ffffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/more_widgets"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="4.0dip" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/widget_picker_watch_faces_bg"
        android:layout_width="fill_parent"
        android:layout_height="28.0dip"
        android:layout_marginTop="6.0dip"
        android:paddingStart="6.0dip"
        android:paddingEnd="7.0dip">
        <ImageView
            android:background="@drawable/widget_picker_watch_faces_icon_bg"
            android:padding="3.0dip"
            android:layout_width="17.0dip"
            android:layout_height="17.0dip"
            android:src="@drawable/wf_ic_watch"
            android:contentDescription="@null" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:layout_marginStart="6.0dip">
            <TextView
                android:textSize="7.5sp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/watch_faces"
                android:maxLines="1"
                android:includeFontPadding="false" />
            <TextView
                android:textSize="6.0sp"
                android:textColor="#b3ffffff"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.0dip"
                android:text="@string/watch_faces_subtitle"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>
        <TextView
            android:textSize="10.0sp"
            android:textColor="#b3ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/intro_preview_chevron"
            android:includeFontPadding="false"
            android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/widget_picker_search_bg"
        android:layout_width="fill_parent"
        android:layout_height="24.0dip"
        android:layout_marginTop="7.0dip"
        android:paddingStart="8.0dip">
        <ImageView
            android:layout_width="11.0dip"
            android:layout_height="11.0dip"
            android:src="@drawable/search_black"
            android:contentDescription="@null" />
        <TextView
            android:textSize="8.0sp"
            android:textColor="#ff737780"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_picker_search_hint"
            android:includeFontPadding="false"
            android:layout_marginStart="6.0dip" />
    </LinearLayout>
    <TextView
        android:textSize="7.0sp"
        android:textColor="#ff5a5e66"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:text="@string/widget_picker_launcher_section"
        android:includeFontPadding="false" />
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5.0dip">
        <include
            android:id="@id/preview_widget_1"
            layout="@layout/intro_preview_widget_card" />
        <include
            android:id="@id/preview_widget_2"
            layout="@layout/intro_preview_widget_card" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6.0dip">
        <include
            android:id="@id/preview_widget_3"
            layout="@layout/intro_preview_widget_card" />
        <include
            android:id="@id/preview_widget_4"
            layout="@layout/intro_preview_widget_card" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6.0dip">
        <include
            android:id="@id/preview_widget_5"
            layout="@layout/intro_preview_widget_card" />
        <include
            android:id="@id/preview_widget_6"
            layout="@layout/intro_preview_widget_card" />
    </LinearLayout>
</LinearLayout>