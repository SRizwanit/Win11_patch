        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7.0dip">
        <include
            android:id="@id/preview_cz_look_1"
            layout="@layout/intro_preview_cz_chip" />
        <include
            android:id="@id/preview_cz_look_2"
            layout="@layout/intro_preview_cz_chip" />
        <include
            android:id="@id/preview_cz_look_3"
            layout="@layout/intro_preview_cz_chip" />
        <include
            android:id="@id/preview_cz_look_4"
            layout="@layout/intro_preview_cz_chip" />
        <include
            android:id="@id/preview_cz_look_5"
            layout="@layout/intro_preview_cz_chip" />
    </LinearLayout>
    <FrameLayout
        android:id="@id/preview_cz_tint"
        android:layout_width="fill_parent"
        android:layout_height="10.0dip"
        android:layout_marginTop="7.0dip"
        android:alpha="0.0">
        <View
            android:layout_gravity="center_vertical"
            android:background="@drawable/intro_preview_cz_hue"
            android:layout_width="fill_parent"
            android:layout_height="7.0dip" />
        <View
            android:layout_gravity="center_vertical"
            android:background="@drawable/intro_preview_cz_knob"
            android:layout_width="10.0dip"
            android:layout_height="10.0dip"
