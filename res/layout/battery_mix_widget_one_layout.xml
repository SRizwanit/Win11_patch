<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/rl_main"
        android:background="@drawable/mint_rounded_corner_bg"
        android:paddingLeft="@dimen/normal_margin"
        android:paddingTop="@dimen/normal_margin"
        android:paddingRight="@dimen/normal_margin"
        android:paddingBottom="@dimen/normal_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/normal_margin"
        android:paddingVertical="@dimen/normal_margin">
        <RelativeLayout
            android:layout_width="80.0dip"
            android:layout_height="80.0dip"
            android:layout_marginRight="@dimen/normal_margin">
            <ProgressBar
                android:id="@id/vertical_progressbar_battery"
                android:layout_width="80.0dip"
                android:layout_height="80.0dip"
                android:progress="55"
                style="@style/ProgressBar.Vertical.Green" />
            <ImageView
                android:id="@id/iv_battery_level"
                android:background="@drawable/circle_storage_dark_green_bg"
                android:layout_width="30.0dip"
                android:layout_height="30.0dip"
                android:layout_marginLeft="@dimen/normal_margin"
                android:layout_marginTop="@dimen/normal_margin"
                android:src="@drawable/ic_phone_charging_white"
                android:scaleType="centerInside" />
            <TextView
                android:textSize="18.0sp"
                android:textStyle="bold"
                android:textColor="#ff075c0a"
                android:gravity="center"
                android:id="@id/tv_battery_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/normal_margin"
                android:layout_marginBottom="@dimen/normal_margin"
                android:text="55%"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true" />
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="80.0dip"
            android:layout_height="80.0dip"
            android:layout_marginRight="@dimen/normal_margin">
            <ProgressBar
                android:id="@id/vertical_progressbar_storage"
                android:layout_width="80.0dip"
                android:layout_height="80.0dip"
                android:progress="55"
                style="@style/ProgressBar.Vertical.Green" />
            <ImageView
                android:id="@id/iv_storage_occupied"
                android:background="@drawable/circle_storage_dark_green_bg"
                android:layout_width="30.0dip"
                android:layout_height="30.0dip"
                android:layout_marginLeft="@dimen/normal_margin"
                android:layout_marginTop="@dimen/normal_margin"
                android:src="@drawable/ic_storage_white"
                android:scaleType="centerInside" />
            <TextView
                android:textSize="18.0sp"
                android:textStyle="bold"
                android:textColor="#ff075c0a"
                android:gravity="center"
                android:id="@id/tv_storage_occupied"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/normal_margin"
                android:layout_marginBottom="@dimen/normal_margin"
                android:text="55%"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true" />
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="80.0dip"
            android:layout_height="80.0dip">
            <ProgressBar
                android:id="@id/vertical_progressbar_ram"
                android:layout_width="80.0dip"
                android:layout_height="80.0dip"
                android:progress="55"
                style="@style/ProgressBar.Vertical.Green" />
            <ImageView
                android:id="@id/iv_ram_used"
                android:background="@drawable/circle_storage_dark_green_bg"
                android:layout_width="30.0dip"
                android:layout_height="30.0dip"
                android:layout_marginLeft="@dimen/normal_margin"
                android:layout_marginTop="@dimen/normal_margin"
                android:src="@drawable/ic_memory_white"
                android:scaleType="centerInside" />
            <TextView
                android:textSize="18.0sp"
                android:textStyle="bold"
                android:textColor="#ff075c0a"
                android:gravity="center"
                android:id="@id/tv_ram_used"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/normal_margin"
                android:layout_marginBottom="@dimen/normal_margin"
                android:text="55%"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true" />
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>