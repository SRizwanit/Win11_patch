<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@id/folder_card"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="12.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/folder_title_bar"
        android:paddingTop="12.0dip"
        android:paddingBottom="8.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16.0dip"
        android:paddingEnd="8.0dip">
        <ImageView
            android:id="@id/folder_title_icon"
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            android:src="@drawable/desktop_folder"
            android:contentDescription="@string/a11y_folder"
            android:layout_marginEnd="12.0dip" />
        <TextView
            android:textSize="16.0sp"
            android:ellipsize="end"
            android:id="@id/folder_title"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1.0"
            android:fontFamily="sans-serif-medium" />
        <ImageButton
            android:id="@id/folder_close"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="10.0dip"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:src="@drawable/ic_close"
            android:scaleType="fitCenter"
            android:contentDescription="@string/a11y_close_folder" />
    </LinearLayout>
    <ScrollView
        android:id="@id/folder_scroll"
        android:paddingTop="8.0dip"
        android:paddingBottom="12.0dip"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:paddingStart="8.0dip"
        android:paddingEnd="8.0dip">
        <com.centsol.w10launcher.home.HomeFolderGrid
            android:id="@id/folder_grid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </ScrollView>
</LinearLayout>