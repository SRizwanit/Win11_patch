<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8.0dip"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="16.0dip"
    app:cardElevation="4.0dip"
    app:strokeWidth="0.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="#ff068bff"
            android:padding="@dimen/normal_margin"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16.0sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:id="@id/tv_font_name"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/medium_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_font_downloads"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <TextView
                android:textSize="12.0sp"
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:id="@id/tv_font_downloads"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.2K"
                android:drawablePadding="6.0dip"
                android:drawableStart="@drawable/ic_download"
                app:layout_constraintBottom_toBottomOf="@id/tv_font_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_font_name" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <RelativeLayout
            android:background="@android:color/white"
            android:padding="16.0dip"
            android:layout_width="fill_parent"
            android:layout_height="150.0dip">
            <ImageView
                android:id="@id/iv_font_preview"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:scaleType="fitCenter" />
        </RelativeLayout>
        <Button
            android:textSize="12.0sp"
            android:textColor="@android:color/white"
            android:layout_gravity="center"
            android:id="@id/btn_apply_font"
            android:layout_width="wrap_content"
            android:layout_height="40.0dip"
            android:layout_marginBottom="@dimen/normal_margin"
            android:text="@string/apply"
            android:textAllCaps="false"
            android:backgroundTint="#ff0084ff"
            app:cornerRadius="20.0dip" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>