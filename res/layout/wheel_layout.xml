<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:padding="16.0dip"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/cl_dialog_content"
        android:paddingBottom="24.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@id/iv_logo"
            android:layout_width="150.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="24.0dip"
            android:src="@drawable/wheel_text"
            android:adjustViewBounds="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/rl_wheel"
            android:layout_width="340.0dip"
            android:layout_height="340.0dip"
            android:layout_marginTop="16.0dip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_logo">
            <ImageView
                android:id="@id/iv_wheel_out"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:src="@drawable/ic_spin_wheel_out"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <ImageView
                android:id="@id/iv_wheel_in"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:src="@drawable/ic_spin_wheel_in"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <ImageView
                android:id="@id/iv_wheel_select_in"
                android:visibility="gone"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:src="@drawable/ic_spin_wheel_select_in"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <ImageView
                android:id="@id/iv_wheel_select_out"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:src="@drawable/ic_spin_wheel_select_out"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="20.0sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@id/btn_spin"
            android:background="@drawable/bg_spin_button"
            android:layout_width="fill_parent"
            android:layout_height="50.0dip"
            android:layout_marginTop="24.0dip"
            android:text="@string/spin_now"
            android:layout_marginStart="48.0dip"
            android:layout_marginEnd="48.0dip"
            app:layout_constraintTop_toBottomOf="@id/rl_wheel" />
        <TextView
            android:textSize="12.0sp"
            android:textColor="#ffbdbdbd"
            android:id="@id/tv_spin_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12.0dip"
            android:text="@string/one_spin_left"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_spin" />
        <TextView
            android:textSize="18.0sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@id/btn_watch_ad"
            android:background="@drawable/bg_spin_button"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="50.0dip"
            android:layout_marginTop="16.0dip"
            android:text="@string/watch_ad_extra_spin"
            android:layout_marginStart="48.0dip"
            android:layout_marginEnd="48.0dip"
            android:backgroundTint="#ffff9800"
            app:layout_constraintTop_toBottomOf="@id/tv_spin_left" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@id/iv_close"
        android:background="@drawable/circle_bg"
        android:padding="10.0dip"
        android:layout_width="40.0dip"
        android:layout_height="40.0dip"
        android:src="@drawable/ic_close_icon"
        android:elevation="8.0dip"
        android:backgroundTint="#fff44336"
        app:layout_constraintEnd_toEndOf="@id/cl_dialog_content"
        app:layout_constraintTop_toTopOf="@id/cl_dialog_content"
        app:tint="@android:color/white" />
</androidx.constraintlayout.widget.ConstraintLayout>