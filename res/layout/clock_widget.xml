<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:cc="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/ll_bg"
        android:background="#ee000000"
        android:paddingLeft="@dimen/normal_margin"
        android:layout_width="200.0dip"
        android:layout_height="65.0dip">
        <CustomTextClock.TextClock
            android:textSize="28.0sp"
            android:textColor="#ffffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip"
            cc:format12Hour="hh:mm a"
            cc:format24Hour="HH:mm" />
        <CustomTextClock.TextClock
            android:textSize="12.0sp"
            android:textColor="@color/blue_time_color"
            android:id="@id/tc_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/medium_margin"
            cc:format12Hour="EEEE, MMMM d, yyyy"
            cc:format24Hour="EEEE, MMMM d, yyyy" />
    </LinearLayout>
</LinearLayout>