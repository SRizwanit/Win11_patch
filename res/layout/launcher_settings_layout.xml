<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@color/setting_screen_bg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/adContainer">
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/medium_margin"
            android:layout_marginBottom="@dimen/medium_margin">
            <ImageView
                android:id="@id/iv_back"
                android:background="@drawable/ripple_settings_round_bg"
                android:padding="@dimen/normal_margin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_arrow_back"
                android:layout_centerVertical="true" />
            <TextView
                android:textSize="18.0sp"
                android:textColor="#80000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/activity_horizontal_margin"
                android:text="@string/settings_launcher"
                android:layout_toRightOf="@id/iv_back"
                android:layout_centerVertical="true" />
            <ImageView
                android:id="@id/iv_rate_us"
                android:background="@drawable/ripple_settings_round_bg"
                android:padding="@dimen/normal_margin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/rate_us"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true" />
            <ImageView
                android:id="@id/iv_share"
                android:background="@drawable/ripple_settings_round_bg"
                android:padding="@dimen/normal_margin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/share"
                android:layout_toLeftOf="@id/iv_rate_us"
                android:layout_centerVertical="true" />
            <ImageView
                android:id="@id/iv_guide"
                android:background="@drawable/ripple_settings_round_bg"
                android:padding="@dimen/normal_margin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/guide_icon"
                android:layout_toLeftOf="@id/iv_share"
                android:layout_centerVertical="true"
                android:contentDescription="@string/show_guide" />
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="160.0dip"
                android:layout_height="wrap_content">
                <AutoCompleteTextView
                    android:textColor="@android:color/black"
                    android:id="@id/ac_tv_search_settings"
                    android:background="@drawable/et_settings_bg"
                    android:layout_width="fill_parent"
                    android:layout_height="45.0dip"
                    android:layout_marginLeft="@dimen/medium_margin"
                    android:layout_marginRight="@dimen/medium_margin"
                    android:hint="@string/find_a_setting"
                    android:singleLine="true"
                    android:drawableRight="@drawable/search_settings_icon"
                    android:drawablePadding="@dimen/medium_margin"
                    android:imeOptions="actionDone" />
                <ListView
                    android:id="@id/lv_quick_access"
                    android:scrollbars="none"
                    android:layout_width="160.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/medium_margin"
                    android:divider="@null"
                    android:dividerHeight="0.0dip" />
            </LinearLayout>
            <FrameLayout
                android:id="@id/fl_subsection"
                android:background="@android:color/white"
                android:padding="@dimen/medium_margin"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/adContainer"
        android:layout_width="fill_parent"
        android:layout_height="50.0dip"
        android:layout_marginTop="@dimen/normal_margin"
        android:layout_marginBottom="@dimen/normal_margin"
        android:layout_alignParentBottom="true" />
</RelativeLayout>