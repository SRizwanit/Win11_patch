<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/ll_blur_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/w11_menu_surface"
            android:padding="4.0dip"
            android:layout_width="216.0dip"
            android:layout_height="wrap_content"
            android:elevation="6.0dip">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/ll_main"
                android:background="@drawable/w11_menu_item_bg"
                android:layout_width="fill_parent"
                android:layout_height="40.0dip"
                android:paddingStart="10.0dip"
                android:paddingEnd="10.0dip">
                <ImageView
                    android:id="@id/item_info"
                    android:layout_width="22.0dip"
                    android:layout_height="22.0dip"
                    android:src="@drawable/info_icon"
                    android:contentDescription="@null" />
                <TextView
                    android:textSize="13.0sp"
                    android:textColor="#e61b1b1b"
                    android:ellipsize="end"
                    android:id="@id/item_lable"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1.0"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="12.0dip" />
            </LinearLayout>
            <View
                android:background="#14000000"
                android:layout_width="fill_parent"
                android:layout_height="1.0dip"
                android:layout_marginTop="3.0dip"
                android:layout_marginBottom="3.0dip"
                android:layout_marginStart="6.0dip"
                android:layout_marginEnd="6.0dip" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/menu_container"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>