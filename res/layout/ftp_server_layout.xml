<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_margin="15.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <Button
        android:textSize="16.0sp"
        android:textColor="@android:color/white"
        android:id="@id/startServer"
        android:padding="15.0dip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fm_start"
        android:layout_centerHorizontal="true"
        android:backgroundTint="@color/blue_btn_bg" />
    <TextView
        android:textSize="16.0sp"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:id="@id/helpText"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10.0dip"
        android:text="@string/enter_the_following_address_in_your_computer_browser"
        android:layout_centerInParent="true" />
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/helpText"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="17.0sp"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@id/ftp_server_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start_server_for_file_sharing" />
        <ImageButton
            android:id="@id/copy_ftp_link_btn"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="4.0dip"
            android:visibility="gone"
            android:layout_width="32.0dip"
            android:layout_height="32.0dip"
            android:src="@drawable/copy_n"
            android:contentDescription="@string/copy_link"
            android:layout_marginStart="8.0dip" />
    </LinearLayout>
</RelativeLayout>