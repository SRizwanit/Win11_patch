<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_gravity="end"
    android:id="@id/rl_main_action_center"
    android:padding="@dimen/medium_margin"
    android:layout_width="300.0dip"
    android:layout_height="fill_parent"
    android:layout_marginTop="@dimen/xlarge_margin"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@id/rl_action_center_blur"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@id/rl_action_center"
        android:layout_alignTop="@id/rl_action_center"
        android:layout_alignRight="@id/rl_action_center"
        android:layout_alignBottom="@id/rl_action_center" />
    <RelativeLayout
        android:id="@id/rl_action_center"
        android:padding="@dimen/medium_margin"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:layout_gravity="end"
            android:orientation="vertical"
            android:paddingLeft="@dimen/medium_margin"
            android:paddingTop="@dimen/normal_margin"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_above="@id/ll_shortcuts"
            android:layout_alignParentRight="true">
            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12.0sp"
                    android:textColor="@android:color/white"
                    android:id="@id/tv_action_center"
                    android:paddingTop="@dimen/small_margin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_center" />
                <TextView
                    android:textSize="12.0sp"
                    android:textColor="@android:color/white"
                    android:id="@id/tv_clearAll"
                    android:padding="@dimen/small_margin"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/medium_margin"
                    android:text="@string/clear_all"
                    android:layout_alignParentRight="true" />
                <ImageView
                    android:id="@id/iv_action_center_edit"
                    android:paddingLeft="@dimen/medium_margin"
                    android:paddingTop="@dimen/small_margin"
                    android:paddingRight="@dimen/medium_margin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/medium_margin"
                    android:src="@drawable/action_center_edit"
                    android:layout_toLeftOf="@id/tv_clearAll"
                    android:layout_alignTop="@id/tv_action_center"
                    android:layout_alignBottom="@id/tv_action_center"
                    android:layout_alignWithParentIfMissing="true"
                    android:contentDescription="@string/edit" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/rl_enable_noti"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/large_margin"
                android:layout_marginRight="@dimen/medium_margin">
                <TextView
                    android:textSize="12.0sp"
                    android:textColor="@android:color/white"
                    android:gravity="center_vertical"
                    android:id="@id/tv_enable_noti"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_notification"
                    android:drawablePadding="@dimen/medium_margin" />
                <ToggleButton
                    android:id="@id/cb_enable_not"
                    android:background="@null"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/toggle_white"
                    android:textOn=""
                    android:textOff=""
                    android:minWidth="0.0dip"
                    android:minHeight="0.0dip"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:buttonTint="@android:color/white" />
            </RelativeLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="horizontal"
                android:id="@id/rv_media_notifications"
                android:clipToPadding="false"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/medium_margin"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_behavior="@string/appbar_scrolling_view_behavior" />
            <ru.tinkoff.scrollingpagerindicator.ScrollingPagerIndicator
                android:layout_gravity="center_horizontal"
                android:id="@id/rv_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:spi_dotColor="@android:color/white"
                app:spi_dotSelectedColor="@android:color/white" />
            <TextView
                android:textSize="12.0sp"
                android:textColor="@android:color/darker_gray"
                android:id="@id/tv_noNotification"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20.0dip"
                android:text="@string/no_new_notifications" />
            <com.centsol.w10launcher.springback.view.SpringBackLayout
                android:id="@id/spring_layout"
                android:background="@drawable/trans_rounded_rectangle"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginRight="@dimen/medium_margin"
                android:layout_marginBottom="@dimen/normal_margin"
                app:scrollOrientation="vertical">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@id/rv_notifications"
                    android:clipToPadding="false"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginTop="5.0dip"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior" />
            </com.centsol.w10launcher.springback.view.SpringBackLayout>
        </LinearLayout>
        <ScrollView
            android:id="@id/ll_shortcuts"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/panel_slider_grid">
            <com.centsol.w10launcher.panel.PanelGridView
                android:id="@id/panel_grid"
                android:padding="@dimen/medium_margin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />
        </ScrollView>
        <com.centsol.w10launcher.panel.PanelGridView
            android:id="@id/panel_slider_grid"
            android:paddingLeft="@dimen/medium_margin"
            android:paddingRight="@dimen/medium_margin"
            android:paddingBottom="@dimen/medium_margin"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/ll_panel_edit_bar"
            android:layout_alignWithParentIfMissing="true" />
        <LinearLayout
            android:gravity="end|center"
            android:orientation="horizontal"
            android:id="@id/ll_panel_edit_bar"
            android:paddingLeft="@dimen/medium_margin"
            android:paddingRight="@dimen/medium_margin"
            android:paddingBottom="@dimen/medium_margin"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <TextView
                android:id="@id/tv_panel_reset"
                android:text="@string/panel_reset"
                style="@style/ActionCenterEditButton" />
            <TextView
                android:id="@id/tv_panel_add"
                android:layout_marginLeft="@dimen/medium_margin"
                android:text="@string/panel_add"
                style="@style/ActionCenterEditButton" />
            <TextView
                android:id="@id/tv_panel_done"
                android:layout_marginLeft="@dimen/medium_margin"
                android:text="@string/done"
                style="@style/ActionCenterEditButton" />
        </LinearLayout>
        <FrameLayout
            android:id="@id/fl_panel_tiles"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.centsol.w10launcher.panel.PanelTileView
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/ll_airplane"
                android:background="@drawable/black_rounded_bg_action_center"
                android:layout_width="fill_parent"
                android:layout_height="55.0dip">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@id/lottie_airplane"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    app:lottie_loop="false" />
                <TextView
                    android:textSize="11.0sp"
                    android:textColor="@android:color/white"
                    android:id="@id/tv_airplane"
                    android:padding="@dimen/medium_margin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/airplane"
                    android:singleLine="true" />
            </com.centsol.w10launcher.panel.PanelTileView>
            <com.centsol.w10launcher.panel.PanelTileView
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/ll_wifi"
                android:background="@drawable/black_rounded_bg_action_center"
                android:layout_width="fill_parent"
                android:layout_height="55.0dip">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@id/lottie_wifi"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    app:lottie_loop="false" />
                <TextView
                    android:textSize="11.0sp"
                    android:textColor="@android:color/white"
                    android:id="@id/tv_wifi"
                    android:padding="@dimen/medium_margin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wifi"
                    android:singleLine="true" />
            </com.centsol.w10launcher.panel.PanelTileView>
            <com.centsol.w10launcher.panel.PanelTileView
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/ll_bluetooth"
                android:background="@drawable/black_rounded_bg_action_center"
                android:layout_width="fill_parent"
                android:layout_height="55.0dip">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@id/lottie_bluetooth"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    app:lottie_loop="false" />
                <TextView
                    android:textSize="11.0sp"
                    android:textColor="@android:color/white"
                    android:id="@id/tv_bluetooth"
                    android:padding="@dimen/medium_margin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bluetooth"
                    android:singleLine="true" />
            </com.centsol.w10launcher.panel.PanelTileView>
            <com.centsol.w10launcher.panel.PanelTileView
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/ll_flash"
                android:background="@drawable/black_rounded_bg_action_center"
                android:layout_width="fill_parent"
                android:layout_height="55.0dip">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@id/lottie_flash"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    app:lottie_loop="false" />
                <TextView
                    android:textSize="11.0sp"
                    android:textColor="@android:color/white"
                    android:id="@id/tv_flash"
                    android:padding="@dimen/medium_margin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/flashlight"
                    android:singleLine="true" />
            </com.centsol.w10launcher.panel.PanelTileView>
            <com.centsol.w10launcher.panel.PanelTileView
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/ll_brightness"
                android:background="@drawable/black_rounded_bg_action_center"
                android:layout_width="fill_parent"
                android:layout_height="55.0dip">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@id/lottie_brightness"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    app:lottie_loop="false" />
                <TextView
                    android:textSize="11.0sp"
                    android:textColor="@android:color/white"
                    android:id="@id/tv_brightness"
                    android:padding="@dimen/medium_margin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/manual"
                    android:singleLine="true" />
            </com.centsol.w10launcher.panel.PanelTileView>
            <com.centsol.w10launcher.panel.PanelTileView
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/ll_data"
                android:background="@drawable/black_rounded_bg_action_center"
                android:layout_width="fill_parent"
                android:layout_height="55.0dip">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@id/lottie_data"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    app:lottie_loop="false" />
                <TextView
                    android:textSize="11.0sp"
                    android:textColor="@android:color/white"
                    android:id="@id/tv_data"
                    android:padding="@dimen/medium_margin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/data"
                    android:singleLine="true" />
            </com.centsol.w10launcher.panel.PanelTileView>
            <com.centsol.w10launcher.panel.PanelTileView
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/ll_rotate"
                android:background="@drawable/black_rounded_bg_action_center"
                android:layout_width="fill_parent"
                android:layout_height="55.0dip">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@id/lottie_rotate"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    app:lottie_loop="false" />
                <TextView
                    android:textSize="11.0sp"
                    android:textColor="@android:color/white"
                    android:id="@id/tv_rotate"
                    android:padding="@dimen/medium_margin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rotate"
                    android:singleLine="true" />
            </com.centsol.w10launcher.panel.PanelTileView>
            <com.centsol.w10launcher.panel.PanelTileView
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/ll_hotspot"
                android:background="@drawable/black_rounded_bg_action_center"
                android:layout_width="fill_parent"
                android:layout_height="55.0dip">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@id/lottie_hotspot"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    app:lottie_loop="false" />
                <TextView
                    android:textSize="11.0sp"
                    android:textColor="@android:color/white"
                    android:id="@id/tv_hotspot"
                    android:padding="@dimen/medium_margin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hotspot"
                    android:singleLine="true" />
            </com.centsol.w10launcher.panel.PanelTileView>
            <com.centsol.w10launcher.panel.PanelTileView
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/ll_location"
                android:background="@drawable/black_rounded_bg_action_center"
                android:layout_width="fill_parent"
                android:layout_height="55.0dip">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@id/lottie_location"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    app:lottie_loop="false" />
                <TextView
                    android:textSize="11.0sp"
                    android:textColor="@android:color/white"
                    android:id="@id/tv_location"
                    android:padding="@dimen/medium_margin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/location"
                    android:singleLine="true" />
            </com.centsol.w10launcher.panel.PanelTileView>
            <com.centsol.w10launcher.panel.PanelTileView
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/ll_system_settings"
                android:background="@drawable/black_rounded_bg_action_center"
                android:layout_width="fill_parent"
                android:layout_height="55.0dip">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@id/lottie_system_settings"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    app:lottie_loop="false" />
                <TextView
                    android:textSize="11.0sp"
                    android:textColor="@android:color/white"
                    android:id="@id/tv_system_settings"
                    android:padding="@dimen/medium_margin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_launcher"
                    android:singleLine="true" />
            </com.centsol.w10launcher.panel.PanelTileView>
            <com.centsol.w10launcher.panel.PanelTileView
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/ll_sound"
                android:background="@drawable/black_rounded_bg_action_center"
                android:layout_width="fill_parent"
                android:layout_height="55.0dip">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@id/lottie_sound"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    app:lottie_loop="false" />
                <TextView
                    android:textSize="11.0sp"
                    android:textColor="@android:color/white"
                    android:id="@id/tv_sound"
                    android:padding="@dimen/medium_margin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sound"
                    android:singleLine="true" />
            </com.centsol.w10launcher.panel.PanelTileView>
            <com.centsol.w10launcher.panel.PanelTileView
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/ll_background"
                android:background="@drawable/black_rounded_bg_action_center"
                android:layout_width="fill_parent"
                android:layout_height="55.0dip">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@id/lottie_background"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    app:lottie_loop="false" />
                <TextView
                    android:textSize="11.0sp"
                    android:textColor="@android:color/white"
                    android:id="@id/tv_wallpapers"
                    android:padding="@dimen/medium_margin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wallpapers"
                    android:singleLine="true" />
            </com.centsol.w10launcher.panel.PanelTileView>
            <com.centsol.w10launcher.panel.PanelSliderView
                android:id="@id/fl_brightness_slider"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/tile_brightness">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/ll_brightness_seekbar"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@id/iv_sound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/brightness_icon" />
                    <androidx.appcompat.widget.AppCompatSeekBar
                        android:id="@id/sb_brightness"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:max="255" />
                </LinearLayout>
            </com.centsol.w10launcher.panel.PanelSliderView>
            <com.centsol.w10launcher.panel.PanelSliderView
                android:id="@id/fl_volume_slider"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/tile_media_volume">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/ll_sound_seekbar"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@id/iv_brightness"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/sound_seekbar" />
                    <androidx.appcompat.widget.AppCompatSeekBar
                        android:id="@id/sb_sound"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:max="255" />
                </LinearLayout>
            </com.centsol.w10launcher.panel.PanelSliderView>
        </FrameLayout>
    </RelativeLayout>
</RelativeLayout>