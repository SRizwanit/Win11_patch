<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/iv_mock_background"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:scaleType="centerCrop" />
    <RelativeLayout
        android:id="@id/rl_mock_status_bar"
        android:paddingLeft="12.0dip"
        android:paddingRight="12.0dip"
        android:layout_width="fill_parent"
        android:layout_height="24.0dip"
        android:layout_marginTop="@dimen/normal_margin"
        android:paddingHorizontal="12.0dip">
        <TextView
            android:textSize="12.0sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3:29" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true">
            <ImageView
                android:layout_width="16.0dip"
                android:layout_height="16.0dip"
                android:src="@drawable/ic_wifi"
                app:tint="@android:color/white" />
            <ImageView
                android:layout_width="16.0dip"
                android:layout_height="16.0dip"
                android:src="@drawable/ic_signal_cellular"
                android:layout_marginStart="4.0dip"
                app:tint="@android:color/white" />
            <TextView
                android:textSize="12.0sp"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="92%"
                android:layout_marginStart="4.0dip" />
        </LinearLayout>
    </RelativeLayout>
    <GridLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:layout_marginBottom="8.0dip"
        android:layout_above="@id/ll_mock_dock"
        android:layout_below="@id/rl_mock_status_bar"
        android:rowCount="6"
        android:useDefaultMargins="false"
        android:alignmentMode="alignMargins"
        android:layout_marginStart="8.0dip"
        android:layout_alignParentStart="true">
        <include
            android:id="@id/mock_icon_gmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8.0dip"
            android:layout_marginEnd="8.0dip"
            layout="@layout/item_mock_icon" />
        <include
            android:id="@id/mock_icon_youtube"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8.0dip"
            android:layout_marginEnd="8.0dip"
            layout="@layout/item_mock_icon" />
        <include
            android:id="@id/mock_icon_chrome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8.0dip"
            android:layout_marginEnd="8.0dip"
            layout="@layout/item_mock_icon" />
        <include
            android:id="@id/mock_icon_maps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8.0dip"
            android:layout_marginEnd="8.0dip"
            layout="@layout/item_mock_icon" />
        <include
            android:id="@id/mock_icon_google_photos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8.0dip"
            android:layout_marginEnd="8.0dip"
            layout="@layout/item_mock_icon" />
        <include
            android:id="@id/mock_icon_google_drive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8.0dip"
            android:layout_marginEnd="8.0dip"
            layout="@layout/item_mock_icon" />
        <include
            android:id="@id/mock_icon_calendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8.0dip"
            android:layout_marginEnd="8.0dip"
            layout="@layout/item_mock_icon" />
        <include
            android:id="@id/mock_icon_play_store"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8.0dip"
            android:layout_marginEnd="8.0dip"
            layout="@layout/item_mock_icon" />
    </GridLayout>
    <LinearLayout
        android:gravity="end"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32.0dip"
        android:layout_below="@id/rl_mock_status_bar"
        android:layout_marginEnd="16.0dip"
        android:layout_alignParentEnd="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/ll_mock_search"
            android:background="@drawable/search_widget_bg"
            android:paddingLeft="12.0dip"
            android:paddingRight="12.0dip"
            android:layout_width="160.0dip"
            android:layout_height="40.0dip"
            android:paddingHorizontal="12.0dip">
            <ImageView
                android:id="@id/iv_search_btn"
                android:layout_width="20.0dip"
                android:layout_height="20.0dip"
                android:src="@drawable/search_google" />
            <View
                android:id="@id/tv_ok_google"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0" />
            <ImageView
                android:id="@id/iv_lense"
                android:layout_width="20.0dip"
                android:layout_height="20.0dip"
                android:src="@drawable/ic_lens"
                android:layout_marginEnd="12.0dip"
                app:tint="#ff5f6368" />
            <ImageView
                android:id="@id/iv_voice_search"
                android:layout_width="20.0dip"
                android:layout_height="20.0dip"
                android:src="@drawable/ic_mic"
                app:tint="#ff5f6368" />
        </LinearLayout>
        <RelativeLayout
            android:id="@id/rl_mock_clock"
            android:layout_width="100.0dip"
            android:layout_height="100.0dip"
            android:layout_marginTop="24.0dip"
            android:layout_marginEnd="25.0dip">
            <ImageView
                android:id="@id/iv_mock_clock"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:src="@drawable/analog_clock" />
        </RelativeLayout>
        <include
            android:id="@id/mock_battery_widget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24.0dip"
            layout="@layout/material_battery_widget_two_layout" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/ll_mock_dock"
        android:background="@color/taskbar_color"
        android:paddingLeft="@dimen/normal_margin"
        android:paddingRight="@dimen/normal_margin"
        android:layout_width="fill_parent"
        android:layout_height="56.0dip"
        android:layout_alignParentBottom="true"
        android:paddingHorizontal="@dimen/normal_margin">
        <ImageView
            android:id="@id/dock_icon_menu"
            android:layout_width="25.0dip"
            android:layout_height="25.0dip"
            android:src="@drawable/window_selector"
            android:scaleType="fitCenter" />
        <ImageView
            android:id="@id/dock_icon_cortana"
            android:layout_width="25.0dip"
            android:layout_height="25.0dip"
            android:src="@drawable/cortana_blue"
            android:scaleType="fitCenter"
            android:layout_marginStart="@dimen/thumb_left_right_margin" />
        <ImageView
            android:id="@id/dock_icon_chrome"
            android:layout_width="25.0dip"
            android:layout_height="25.0dip"
            android:src="@drawable/chrome_icon"
            android:scaleType="fitCenter"
            android:layout_marginStart="@dimen/thumb_left_right_margin" />
        <ImageView
            android:id="@id/dock_icon_message"
            android:layout_width="25.0dip"
            android:layout_height="25.0dip"
            android:src="@drawable/sms"
            android:scaleType="fitCenter"
            android:layout_marginStart="@dimen/thumb_left_right_margin" />
        <ImageView
            android:id="@id/dock_icon_phone"
            android:layout_width="25.0dip"
            android:layout_height="25.0dip"
            android:src="@drawable/phone"
            android:scaleType="fitCenter"
            android:layout_marginStart="@dimen/thumb_left_right_margin" />
        <View
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0" />
        <ImageView
            android:id="@id/dock_icon_arrow"
            android:layout_width="20.0dip"
            android:layout_height="20.0dip"
            android:src="@drawable/up_arrow"
            android:layout_marginEnd="@dimen/medium_margin" />
        <LinearLayout
            android:gravity="end"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/medium_margin">
            <TextView
                android:textSize="10.0sp"
                android:textColor="@android:color/white"
                android:id="@id/tv_dock_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:textSize="10.0sp"
                android:textColor="@android:color/white"
                android:id="@id/tv_dock_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10/02/2026" />
        </LinearLayout>
        <ImageView
            android:id="@id/dock_icon_notification"
            android:layout_width="20.0dip"
            android:layout_height="20.0dip"
            android:src="@drawable/noti_normal" />
    </LinearLayout>
</RelativeLayout>