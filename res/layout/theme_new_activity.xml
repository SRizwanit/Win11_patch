<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@android:color/white"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@id/iv_back"
            android:padding="@dimen/normal_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_back" />
        <TextView
            android:textSize="16.0sp"
            android:textColor="@android:color/black"
            android:id="@id/tv_title"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/activity_horizontal_margin"
            android:text="@string/themes"
            android:layout_weight="1.0" />
        <com.google.android.material.button.MaterialButton
            android:textColor="@android:color/white"
            android:id="@id/btn_set_default"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_default"
            android:textAllCaps="false"
            android:layout_marginEnd="@dimen/normal_margin"
            android:backgroundTint="#ff0084ff" />
    </LinearLayout>
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <com.centsol.w10launcher.util.ViewPagerFixed
            android:id="@id/pager"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_above="@id/navigation" />
        <HorizontalScrollView
            android:id="@id/navigation"
            android:background="@android:color/white"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="56.0dip"
            android:layout_alignParentBottom="true"
            android:elevation="8.0dip"
            android:outlineProvider="background">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@id/nav_themes"
                    android:background="?selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:minWidth="68.0dip"
                    android:layout_weight="1.0">
                    <ImageView
                        android:duplicateParentState="true"
                        android:layout_width="24.0dip"
                        android:layout_height="24.0dip"
                        android:src="@drawable/ic_theme"
                        app:tint="@color/bottom_nav_color_new" />
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="@color/bottom_nav_color_new"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2.0dip"
                        android:text="@string/themes"
                        android:singleLine="true" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@id/nav_wallpapers"
                    android:background="?selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:minWidth="68.0dip"
                    android:layout_weight="1.0">
                    <ImageView
                        android:duplicateParentState="true"
                        android:layout_width="24.0dip"
                        android:layout_height="24.0dip"
                        android:src="@drawable/ic_wallpapers"
                        app:tint="@color/bottom_nav_color_new" />
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="@color/bottom_nav_color_new"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2.0dip"
                        android:text="@string/wallpapers"
                        android:singleLine="true" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@id/nav_ringtones"
                    android:background="?selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:minWidth="68.0dip"
                    android:layout_weight="1.0">
                    <ImageView
                        android:duplicateParentState="true"
                        android:layout_width="24.0dip"
                        android:layout_height="24.0dip"
                        android:src="@drawable/ic_ringtone"
                        app:tint="@color/bottom_nav_color_new" />
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="@color/bottom_nav_color_new"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2.0dip"
                        android:text="@string/ringtone"
                        android:singleLine="true" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@id/nav_fonts"
                    android:background="?selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:minWidth="68.0dip"
                    android:layout_weight="1.0">
                    <ImageView
                        android:duplicateParentState="true"
                        android:layout_width="24.0dip"
                        android:layout_height="24.0dip"
                        android:src="@drawable/ic_fonts"
                        app:tint="@color/bottom_nav_color_new" />
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="@color/bottom_nav_color_new"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2.0dip"
                        android:text="@string/fonts"
                        android:singleLine="true" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@id/nav_stickers"
                    android:background="?selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:minWidth="68.0dip"
                    android:layout_weight="1.0">
                    <ImageView
                        android:duplicateParentState="true"
                        android:layout_width="24.0dip"
                        android:layout_height="24.0dip"
                        android:src="@drawable/ic_stickers"
                        app:tint="@color/bottom_nav_color_new" />
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="@color/bottom_nav_color_new"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2.0dip"
                        android:text="@string/stickers"
                        android:singleLine="true" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@id/nav_profile"
                    android:background="?selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:minWidth="68.0dip"
                    android:layout_weight="1.0">
                    <ImageView
                        android:duplicateParentState="true"
                        android:layout_width="24.0dip"
                        android:layout_height="24.0dip"
                        android:src="@drawable/ic_profile"
                        app:tint="@color/bottom_nav_color_new" />
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="@color/bottom_nav_color_new"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2.0dip"
                        android:text="@string/profile"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>
    </RelativeLayout>
</LinearLayout>