<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@id/app_picker_frame"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_app_picker_card"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <TextView
            android:textSize="20.0sp"
            android:textColor="#de000000"
            android:id="@id/app_picker_title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20.0dip"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="24.0dip"
            android:layout_marginEnd="24.0dip" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="#99000000"
            android:id="@id/app_picker_subtitle"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.0dip"
            android:layout_marginStart="24.0dip"
            android:layout_marginEnd="24.0dip" />
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_app_picker_search"
            android:layout_width="fill_parent"
            android:layout_height="44.0dip"
            android:layout_marginTop="16.0dip"
            android:paddingStart="14.0dip"
            android:paddingEnd="8.0dip"
            android:layout_marginStart="20.0dip"
            android:layout_marginEnd="20.0dip">
            <ImageView
                android:layout_width="20.0dip"
                android:layout_height="20.0dip"
                android:src="@drawable/search_icon"
                android:contentDescription="@null"
                android:alpha="0.55" />
            <EditText
                android:textSize="15.0sp"
                android:textColor="#de000000"
                android:textColorHint="#61000000"
                android:id="@id/app_picker_search"
                android:background="@null"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:hint="@string/app_picker_search_hint"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_weight="1.0"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:layout_marginStart="10.0dip"
                android:importantForAutofill="no" />
            <ImageView
                android:id="@id/app_picker_clear"
                android:background="?android:selectableItemBackgroundBorderless"
                android:padding="8.0dip"
                android:visibility="gone"
                android:layout_width="32.0dip"
                android:layout_height="32.0dip"
                android:src="@drawable/ic_app_picker_clear"
                android:contentDescription="@string/cancel" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_marginTop="8.0dip"
            android:layout_weight="1.0">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@id/app_picker_list"
                android:paddingBottom="8.0dip"
                android:scrollbars="vertical"
                android:clipToPadding="false"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent" />
            <ProgressBar
                android:layout_gravity="center"
                android:id="@id/app_picker_progress"
                android:layout_width="32.0dip"
                android:layout_height="32.0dip" />
            <TextView
                android:textSize="14.0sp"
                android:textColor="#61000000"
                android:layout_gravity="center"
                android:id="@id/app_picker_empty"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_picker_empty" />
        </FrameLayout>
        <LinearLayout
            android:gravity="end|center"
            android:orientation="horizontal"
            android:id="@id/app_picker_buttons"
            android:paddingTop="4.0dip"
            android:paddingBottom="12.0dip"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16.0dip"
            android:paddingEnd="16.0dip">
            <TextView
                android:textSize="14.0sp"
                android:textColor="#99000000"
                android:gravity="center"
                android:id="@id/app_picker_cancel"
                android:background="?android:selectableItemBackground"
                android:layout_width="wrap_content"
                android:layout_height="40.0dip"
                android:text="@string/cancel"
                android:textAllCaps="true"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="16.0dip"
                android:paddingEnd="16.0dip" />
            <TextView
                android:textSize="14.0sp"
                android:textColor="@color/tile_color"
                android:gravity="center"
                android:id="@id/app_picker_add"
                android:background="?android:selectableItemBackground"
                android:layout_width="wrap_content"
                android:layout_height="40.0dip"
                android:text="@string/app_picker_add"
                android:textAllCaps="true"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="16.0dip"
                android:paddingEnd="16.0dip"
                android:layout_marginStart="8.0dip" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>