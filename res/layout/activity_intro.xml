<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/intro_root"
    android:background="@drawable/intro_bg"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="15.0sp"
        android:textColor="#b3ffffff"
        android:layout_gravity="end"
        android:id="@id/btn_skip"
        android:background="?android:selectableItemBackgroundBorderless"
        android:paddingTop="16.0dip"
        android:paddingBottom="16.0dip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/intro_skip"
        android:paddingStart="20.0dip"
        android:paddingEnd="20.0dip" />
    <androidx.viewpager.widget.ViewPager
        android:id="@id/intro_pager"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12.0dip"
        android:paddingBottom="20.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24.0dip"
        android:paddingEnd="24.0dip">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/intro_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <Space
            android:layout_width="0.0dip"
            android:layout_height="1.0dip"
            android:layout_weight="1.0" />
        <TextView
            android:textSize="16.0sp"
            android:textStyle="bold"
            android:textColor="#ff00437a"
            android:id="@id/btn_next"
            android:background="@drawable/intro_btn_bg"
            android:paddingTop="13.0dip"
            android:paddingBottom="13.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="120.0dip"
            android:text="@string/intro_next"
            android:textAlignment="center"
            android:paddingStart="28.0dip"
            android:paddingEnd="28.0dip"
            android:elevation="3.0dip" />
    </LinearLayout>
</LinearLayout>