<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:paddingRight="90.0dip"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:id="@id/ll_hidden_icons_blur"
        android:layout_width="100.0dip"
        android:layout_height="150.0dip"
        android:layout_marginBottom="@dimen/medium_margin"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/ll_main_hidden_icons"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:weightSum="3.0">
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:weightSum="2.0"
                android:layout_weight="1.0">
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:layout_weight="1.0">
                    <ImageView
                        android:id="@id/iv_gsmSignalInfo"
                        android:background="@drawable/panel_bg_rounded"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_margin="@dimen/medium_margin"
                        android:src="@drawable/signal_0"
                        android:scaleType="centerInside"
                        android:contentDescription="@string/a11y_sim_signal" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:layout_weight="1.0">
                    <ImageView
                        android:id="@id/iv_wifi"
                        android:background="@drawable/panel_bg_rounded"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_margin="@dimen/medium_margin"
                        android:src="@drawable/wifi"
                        android:scaleType="centerInside"
                        android:contentDescription="@string/a11y_wifi" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:weightSum="2.0"
                android:layout_weight="1.0">
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:layout_weight="1.0">
                    <ImageView
                        android:id="@id/iv_bluetooth"
                        android:background="@drawable/panel_bg_rounded"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_margin="@dimen/medium_margin"
                        android:src="@drawable/bluetooth"
                        android:scaleType="centerInside"
                        android:contentDescription="@string/bluetooth" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:layout_weight="1.0">
                    <ImageView
                        android:id="@id/iv_volume"
                        android:background="@drawable/panel_bg_rounded"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_margin="@dimen/medium_margin"
                        android:src="@drawable/sound0"
                        android:scaleType="centerInside"
                        android:contentDescription="@string/a11y_volume" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:weightSum="2.0"
                android:layout_weight="1.0">
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:layout_weight="1.0">
                    <ImageView
                        android:id="@id/BatteryInfo"
                        android:background="@drawable/panel_bg_rounded"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_margin="@dimen/medium_margin"
                        android:src="@drawable/normal_01"
                        android:scaleType="centerInside"
                        android:contentDescription="@string/a11y_charging_status" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:layout_weight="1.0">
                    <TextView
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:id="@id/tv_battery_hidden_layout"
                        android:background="@drawable/panel_bg_rounded"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_margin="@dimen/medium_margin"
                        android:text="20%" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>