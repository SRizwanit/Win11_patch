<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:id="@id/add_item_drag_layer"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:theme="@style/AlertDialogCustom"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@id/add_item_bottom_sheet_content"
        android:background="@drawable/bg_material_dialog"
        android:padding="24.0dip"
        android:layout_width="300.0dip"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="?textAppearanceHeadlineSmall"
            android:textColor="?colorOnSurface"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@id/widget_appName"
            android:fadingEdge="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true" />
        <ImageView
            android:layout_gravity="center"
            android:id="@id/widget_cell"
            android:padding="16.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/skype"
            android:layout_weight="1.0" />
        <LinearLayout
            android:gravity="end|center"
            android:orientation="horizontal"
            android:paddingTop="8.0dip"
            android:paddingBottom="8.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8.0dip">
            <com.google.android.material.button.MaterialButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@android:string/cancel"
                android:onClick="onCancelClick"
                style="@style/Widget.Material3.Button.TextButton.Dialog" />
            <Space
                android:layout_width="8.0dip"
                android:layout_height="wrap_content" />
            <com.google.android.material.button.MaterialButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_to_home_screen"
                android:onClick="onPlaceAutomaticallyClick"
                style="@style/Widget.Material3.Button.TextButton.Dialog" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>