<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_margin="@dimen/normal_margin"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/normal_margin">
            <RelativeLayout
                android:id="@id/rl_user"
                android:padding="@dimen/normal_margin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@id/iv_user"
                    android:layout_width="30.0dip"
                    android:layout_height="30.0dip"
                    android:src="@drawable/user" />
                <TextView
                    android:textColor="@android:color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/medium_margin"
                    android:text="@string/user"
                    android:layout_toRightOf="@id/iv_user"
                    android:layout_centerVertical="true" />
                <ToggleButton
                    android:id="@id/cb_user"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/toggle_selector"
                    android:textOn=""
                    android:textOff=""
                    android:minWidth="0.0dip"
                    android:minHeight="0.0dip"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/rl_this_pc"
                android:padding="@dimen/normal_margin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@id/iv_this_pc"
                    android:layout_width="30.0dip"
                    android:layout_height="30.0dip"
                    android:src="@drawable/this_pc" />
                <TextView
                    android:textColor="@android:color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/medium_margin"
                    android:text="@string/this_pc"
                    android:layout_toRightOf="@id/iv_this_pc"
                    android:layout_centerVertical="true" />
                <ToggleButton
                    android:id="@id/cb_this_pc"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/toggle_selector"
                    android:textOn=""
                    android:textOff=""
                    android:minWidth="0.0dip"
                    android:minHeight="0.0dip"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/rl_recycle_bin"
                android:padding="@dimen/normal_margin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@id/iv_recycle_bin"
                    android:layout_width="30.0dip"
                    android:layout_height="30.0dip"
                    android:src="@drawable/recycle_bin" />
                <TextView
                    android:textColor="@android:color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/medium_margin"
                    android:text="@string/recycle_bin"
                    android:layout_toRightOf="@id/iv_recycle_bin"
                    android:layout_centerVertical="true" />
                <ToggleButton
                    android:id="@id/cb_recycle_bin"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/toggle_selector"
                    android:textOn=""
                    android:textOff=""
                    android:minWidth="0.0dip"
                    android:minHeight="0.0dip"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/rl_theme"
                android:padding="@dimen/normal_margin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@id/iv_theme"
                    android:layout_width="30.0dip"
                    android:layout_height="30.0dip"
                    android:src="@drawable/themes_desktop_icon" />
                <TextView
                    android:textColor="@android:color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/medium_margin"
                    android:text="@string/theme1"
                    android:layout_toRightOf="@id/iv_theme"
                    android:layout_centerVertical="true" />
                <ToggleButton
                    android:id="@id/cb_theme"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/toggle_selector"
                    android:textOn=""
                    android:textOff=""
                    android:minWidth="0.0dip"
                    android:minHeight="0.0dip"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/rl_settings"
                android:padding="@dimen/normal_margin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@id/iv_settings"
                    android:layout_width="30.0dip"
                    android:layout_height="30.0dip"
                    android:src="@drawable/widget_setting" />
                <TextView
                    android:textColor="@android:color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/medium_margin"
                    android:text="@string/launcher_settings"
                    android:layout_toRightOf="@id/iv_settings"
                    android:layout_centerVertical="true" />
                <ToggleButton
                    android:id="@id/cb_settings"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/toggle_selector"
                    android:textOn=""
                    android:textOff=""
                    android:minWidth="0.0dip"
                    android:minHeight="0.0dip"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/rl_wallpaper"
                android:padding="@dimen/normal_margin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@id/iv_wallpaper"
                    android:layout_width="30.0dip"
                    android:layout_height="30.0dip"
                    android:src="@drawable/widget_wallpaper" />
                <TextView
                    android:textColor="@android:color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/medium_margin"
                    android:text="@string/wallpapers"
                    android:layout_toRightOf="@id/iv_wallpaper"
                    android:layout_centerVertical="true" />
                <ToggleButton
                    android:id="@id/cb_wallpaper"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/toggle_selector"
                    android:textOn=""
                    android:textOff=""
                    android:minWidth="0.0dip"
                    android:minHeight="0.0dip"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/rl_widgets"
                android:padding="@dimen/normal_margin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@id/iv_widgets"
                    android:layout_width="30.0dip"
                    android:layout_height="30.0dip"
                    android:src="@drawable/widgets_desktop_icon"
                    android:contentDescription="@null" />
                <TextView
                    android:textColor="@android:color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/medium_margin"
                    android:text="@string/widgets"
                    android:layout_toRightOf="@id/iv_widgets"
                    android:layout_centerVertical="true" />
                <ToggleButton
                    android:id="@id/cb_widgets"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/toggle_selector"
                    android:textOn=""
                    android:textOff=""
                    android:minWidth="0.0dip"
                    android:minHeight="0.0dip"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/rl_locked_apps"
                android:padding="@dimen/normal_margin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@id/iv_locked_apps"
                    android:layout_width="30.0dip"
                    android:layout_height="30.0dip"
                    android:src="@drawable/locked_app_folder" />
                <TextView
                    android:textColor="@android:color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/medium_margin"
                    android:text="@string/locked_apps"
                    android:layout_toRightOf="@id/iv_locked_apps"
                    android:layout_centerVertical="true" />
                <ToggleButton
                    android:id="@id/cb_locked_apps"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/toggle_selector"
                    android:textOn=""
                    android:textOff=""
                    android:minWidth="0.0dip"
                    android:minHeight="0.0dip"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/rl_flash"
                android:padding="@dimen/normal_margin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@id/iv_flash"
                    android:layout_width="30.0dip"
                    android:layout_height="30.0dip"
                    android:src="@drawable/widget_flash" />
                <TextView
                    android:textColor="@android:color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/medium_margin"
                    android:text="@string/flashlight"
                    android:layout_toRightOf="@id/iv_flash"
                    android:layout_centerVertical="true" />
                <ToggleButton
                    android:id="@id/cb_flash"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/toggle_selector"
                    android:textOn=""
                    android:textOff=""
                    android:minWidth="0.0dip"
                    android:minHeight="0.0dip"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/rl_booster"
                android:padding="@dimen/normal_margin"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@id/iv_booster"
                    android:layout_width="30.0dip"
                    android:layout_height="30.0dip"
                    android:src="@drawable/widget_booster" />
                <TextView
                    android:textColor="@android:color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/medium_margin"
                    android:text="@string/booster"
                    android:layout_toRightOf="@id/iv_booster"
                    android:layout_centerVertical="true" />
                <ToggleButton
                    android:id="@id/cb_booster"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/toggle_selector"
                    android:textOn=""
                    android:textOff=""
                    android:minWidth="0.0dip"
                    android:minHeight="0.0dip"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/rl_spin_wheel"
                android:padding="@dimen/normal_margin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@id/iv_spin_wheel"
                    android:layout_width="30.0dip"
                    android:layout_height="30.0dip"
                    android:src="@drawable/ic_spin_wheel" />
                <TextView
                    android:textColor="@android:color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/medium_margin"
                    android:text="@string/spin_wheel"
                    android:layout_toRightOf="@id/iv_spin_wheel"
                    android:layout_centerVertical="true" />
                <ToggleButton
                    android:id="@id/cb_spin_wheel"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/toggle_selector"
                    android:textOn=""
                    android:textOff=""
                    android:minWidth="0.0dip"
                    android:minHeight="0.0dip"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@id/rl_daily_checkin"
                android:padding="@dimen/normal_margin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@id/iv_daily_checkin"
                    android:layout_width="30.0dip"
                    android:layout_height="30.0dip"
                    android:src="@drawable/ic_daily_checkin" />
                <TextView
                    android:textColor="@android:color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/medium_margin"
                    android:text="@string/daily_checkin_title"
                    android:layout_toRightOf="@id/iv_daily_checkin"
                    android:layout_centerVertical="true" />
                <ToggleButton
                    android:id="@id/cb_daily_checkin"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/toggle_selector"
                    android:textOn=""
                    android:textOff=""
                    android:minWidth="0.0dip"
                    android:minHeight="0.0dip"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>