<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@android:color/white"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="@dimen/fm_titlebar_height">
            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <ImageView
                    android:id="@id/Titlebar_image"
                    android:padding="5.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/pc"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true" />
                <TextView
                    android:textColor="@android:color/black"
                    android:id="@id/Titlebar_name"
                    android:padding="5.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/this_pc"
                    android:singleLine="true"
                    android:layout_toLeftOf="@id/iv_min"
                    android:layout_toRightOf="@id/Titlebar_image"
                    android:layout_centerVertical="true" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/search_container"
                    android:background="@drawable/search_bar_background"
                    android:visibility="gone"
                    android:layout_width="75.0dip"
                    android:layout_height="30.0dip"
                    android:layout_centerVertical="true"
                    android:paddingStart="12.0dip"
                    android:paddingEnd="8.0dip"
                    android:layout_marginEnd="@dimen/normal_margin"
                    android:layout_toStartOf="@id/iv_min">
                    <EditText
                        android:textSize="12.0sp"
                        android:textColor="@android:color/black"
                        android:id="@id/et_search"
                        android:background="@null"
                        android:layout_width="0.0dip"
                        android:layout_height="fill_parent"
                        android:hint="@string/search"
                        android:singleLine="true"
                        android:layout_weight="1.0"
                        android:imeOptions="actionSearch" />
                    <ImageView
                        android:layout_width="15.0dip"
                        android:layout_height="15.0dip"
                        android:src="@drawable/search_black"
                        app:tint="@android:color/darker_gray" />
                </LinearLayout>
                <ImageView
                    android:id="@id/iv_close"
                    android:background="@android:color/transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:src="@drawable/cross_selector"
                    android:minWidth="@dimen/fm_touch_min"
                    android:minHeight="@dimen/fm_touch_min"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true" />
                <ImageView
                    android:id="@id/iv_max"
                    android:background="@android:color/transparent"
                    android:padding="@dimen/medium_margin"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:src="@drawable/max_selector"
                    android:minWidth="@dimen/fm_touch_min"
                    android:minHeight="@dimen/fm_touch_min"
                    android:layout_toLeftOf="@id/iv_close"
                    android:layout_centerVertical="true" />
                <ImageView
                    android:id="@id/iv_min"
                    android:background="@android:color/transparent"
                    android:padding="@dimen/medium_margin"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:src="@drawable/min_selector"
                    android:minWidth="@dimen/fm_touch_min"
                    android:minHeight="@dimen/fm_touch_min"
                    android:layout_toLeftOf="@id/iv_max"
                    android:layout_centerVertical="true" />
            </RelativeLayout>
        </LinearLayout>
        <View
            android:background="#ffd3d3d3"
            android:layout_width="fill_parent"
            android:layout_height="1.0dip" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/fm_toolbar_height">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/toolbar_disabled"
                android:padding="2.0dip"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:weightSum="6.0"
                android:layout_weight="6.0">
                <TextView
                    android:textSize="10.0sp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:paddingLeft="2.0dip"
                    android:paddingTop="@dimen/medium_margin"
                    android:paddingRight="2.0dip"
                    android:paddingBottom="@dimen/medium_margin"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:text="@string/cut"
                    android:maxLines="1"
                    android:drawableTop="@drawable/cut_n"
                    android:layout_weight="1.0"
                    android:paddingHorizontal="2.0dip"
                    android:paddingVertical="@dimen/medium_margin" />
                <TextView
                    android:textSize="10.0sp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:paddingLeft="2.0dip"
                    android:paddingTop="@dimen/medium_margin"
                    android:paddingRight="2.0dip"
                    android:paddingBottom="@dimen/medium_margin"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:text="@string/copy"
                    android:maxLines="1"
                    android:drawableTop="@drawable/copy_n"
                    android:layout_weight="1.0"
                    android:paddingHorizontal="2.0dip"
                    android:paddingVertical="@dimen/medium_margin" />
                <TextView
                    android:textSize="10.0sp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:paddingLeft="2.0dip"
                    android:paddingTop="@dimen/medium_margin"
                    android:paddingRight="2.0dip"
                    android:paddingBottom="@dimen/medium_margin"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:text="@string/paste"
                    android:maxLines="1"
                    android:drawableTop="@drawable/past_n"
                    android:layout_weight="1.0"
                    android:paddingHorizontal="2.0dip"
                    android:paddingVertical="@dimen/medium_margin" />
                <TextView
                    android:textSize="10.0sp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:paddingLeft="2.0dip"
                    android:paddingTop="@dimen/medium_margin"
                    android:paddingRight="2.0dip"
                    android:paddingBottom="@dimen/medium_margin"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:text="@string/delete"
                    android:maxLines="1"
                    android:drawableTop="@drawable/delet_n"
                    android:layout_weight="1.0"
                    android:paddingHorizontal="2.0dip"
                    android:paddingVertical="@dimen/medium_margin" />
                <TextView
                    android:textSize="10.0sp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:paddingLeft="2.0dip"
                    android:paddingTop="@dimen/medium_margin"
                    android:paddingRight="2.0dip"
                    android:paddingBottom="@dimen/medium_margin"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:text="@string/rename"
                    android:maxLines="1"
                    android:drawableTop="@drawable/rename_n"
                    android:layout_weight="1.0"
                    android:paddingHorizontal="2.0dip"
                    android:paddingVertical="@dimen/medium_margin" />
                <TextView
                    android:textSize="10.0sp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:paddingLeft="2.0dip"
                    android:paddingTop="@dimen/medium_margin"
                    android:paddingRight="2.0dip"
                    android:paddingBottom="@dimen/medium_margin"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:text="@string/properties"
                    android:maxLines="1"
                    android:drawableTop="@drawable/properties_n"
                    android:layout_weight="1.0"
                    android:paddingHorizontal="2.0dip"
                    android:paddingVertical="@dimen/medium_margin" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/toolbar_enabled"
                android:padding="2.0dip"
                android:visibility="gone"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:weightSum="6.0"
                android:layout_weight="6.0">
                <TextView
                    android:textSize="10.0sp"
                    android:textColor="@android:color/black"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/cut_btn"
                    android:background="@drawable/ripple_quick_access_item_bg"
                    android:paddingLeft="2.0dip"
                    android:paddingTop="@dimen/medium_margin"
                    android:paddingRight="2.0dip"
                    android:paddingBottom="@dimen/medium_margin"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:text="@string/cut"
                    android:maxLines="1"
                    android:drawableTop="@drawable/cut_s"
                    android:layout_weight="1.0"
                    android:paddingHorizontal="2.0dip"
                    android:paddingVertical="@dimen/medium_margin" />
                <TextView
                    android:textSize="10.0sp"
                    android:textColor="@android:color/black"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/copy_btn"
                    android:background="@drawable/ripple_quick_access_item_bg"
                    android:paddingLeft="2.0dip"
                    android:paddingTop="@dimen/medium_margin"
                    android:paddingRight="2.0dip"
                    android:paddingBottom="@dimen/medium_margin"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:text="@string/copy"
                    android:maxLines="1"
                    android:drawableTop="@drawable/copy_s"
                    android:layout_weight="1.0"
                    android:paddingHorizontal="2.0dip"
                    android:paddingVertical="@dimen/medium_margin" />
                <TextView
                    android:textSize="10.0sp"
                    android:textColor="@android:color/black"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/paste_btn"
                    android:background="@drawable/ripple_quick_access_item_bg"
                    android:paddingLeft="2.0dip"
                    android:paddingTop="@dimen/medium_margin"
                    android:paddingRight="2.0dip"
                    android:paddingBottom="@dimen/medium_margin"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:text="@string/paste"
                    android:maxLines="1"
                    android:drawableTop="@drawable/past_s"
                    android:layout_weight="1.0"
                    android:paddingHorizontal="2.0dip"
                    android:paddingVertical="@dimen/medium_margin" />
                <TextView
                    android:textSize="10.0sp"
                    android:textColor="@android:color/black"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/delete_btn"
                    android:background="@drawable/ripple_quick_access_item_bg"
                    android:paddingLeft="2.0dip"
                    android:paddingTop="@dimen/medium_margin"
                    android:paddingRight="2.0dip"
                    android:paddingBottom="@dimen/medium_margin"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:text="@string/delete"
                    android:maxLines="1"
                    android:drawableTop="@drawable/delet_s"
                    android:layout_weight="1.0"
                    android:paddingHorizontal="2.0dip"
                    android:paddingVertical="@dimen/medium_margin" />
                <TextView
                    android:textSize="10.0sp"
                    android:textColor="@android:color/black"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/rename_btn"
                    android:background="@drawable/ripple_quick_access_item_bg"
                    android:paddingLeft="2.0dip"
                    android:paddingTop="@dimen/medium_margin"
                    android:paddingRight="2.0dip"
                    android:paddingBottom="@dimen/medium_margin"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:text="@string/rename"
                    android:maxLines="1"
                    android:drawableTop="@drawable/rename_s"
                    android:layout_weight="1.0"
                    android:paddingHorizontal="2.0dip"
                    android:paddingVertical="@dimen/medium_margin" />
                <TextView
                    android:textSize="10.0sp"
                    android:textColor="@android:color/black"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/property_btn"
                    android:background="@drawable/ripple_quick_access_item_bg"
                    android:paddingLeft="2.0dip"
                    android:paddingTop="@dimen/medium_margin"
                    android:paddingRight="2.0dip"
                    android:paddingBottom="@dimen/medium_margin"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:text="@string/properties"
                    android:maxLines="1"
                    android:drawableTop="@drawable/properties_s"
                    android:layout_weight="1.0"
                    android:paddingHorizontal="2.0dip"
                    android:paddingVertical="@dimen/medium_margin" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/ll_more"
                android:padding="2.0dip"
                android:visibility="gone"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:weightSum="2.0"
                android:layout_weight="2.0">
                <TextView
                    android:textSize="10.0sp"
                    android:textColor="@android:color/black"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/newfolder"
                    android:background="@drawable/ripple_quick_access_item_bg"
                    android:paddingLeft="2.0dip"
                    android:paddingTop="@dimen/medium_margin"
                    android:paddingRight="2.0dip"
                    android:paddingBottom="@dimen/medium_margin"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:text="@string/new_folder"
                    android:maxLines="1"
                    android:drawableTop="@drawable/toolbar_new_folder"
                    android:layout_weight="1.0"
                    android:paddingHorizontal="2.0dip"
                    android:paddingVertical="@dimen/medium_margin" />
                <TextView
                    android:textSize="10.0sp"
                    android:textColor="@android:color/black"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/more"
                    android:background="@drawable/ripple_quick_access_item_bg"
                    android:paddingLeft="2.0dip"
                    android:paddingTop="@dimen/medium_margin"
                    android:paddingRight="2.0dip"
                    android:paddingBottom="@dimen/medium_margin"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:text="@string/more"
                    android:maxLines="1"
                    android:drawableTop="@drawable/toolbar_more"
                    android:layout_weight="1.0"
                    android:paddingHorizontal="2.0dip"
                    android:paddingVertical="@dimen/medium_margin" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/fm_addressbar_height">
            <ImageView
                android:id="@id/back_btn"
                android:padding="10.0dip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/left"
                android:minWidth="@dimen/fm_touch_min"
                android:minHeight="@dimen/fm_touch_min" />
            <ImageView
                android:id="@id/next_btn"
                android:padding="10.0dip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/right"
                android:minWidth="@dimen/fm_touch_min"
                android:minHeight="@dimen/fm_touch_min" />
            <ImageView
                android:id="@id/up_btn"
                android:padding="10.0dip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/up"
                android:minWidth="@dimen/fm_touch_min"
                android:minHeight="@dimen/fm_touch_min" />
            <EditText
                android:textSize="14.0sp"
                android:textColor="@android:color/black"
                android:layout_gravity="center"
                android:id="@id/address"
                android:background="@drawable/rectangular_bg"
                android:padding="5.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/this_pc"
                android:cursorVisible="false"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="@dimen/fm_sidebar_width"
            android:layout_height="fill_parent">
            <ExpandableListView
                android:id="@id/quick_link_listview"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:transcriptMode="alwaysScroll"
                android:groupIndicator="@drawable/group_indicator"
                android:divider="@null" />
            <TextView
                android:textSize="12.0sp"
                android:textColor="@android:color/black"
                android:gravity="center_vertical"
                android:id="@id/thisPc"
                android:background="@drawable/ripple_quick_access_item_bg"
                android:padding="@dimen/normal_margin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/this_pc"
                android:drawableLeft="@drawable/pc"
                android:drawablePadding="@dimen/medium_margin" />
            <TextView
                android:textSize="12.0sp"
                android:textColor="@android:color/black"
                android:gravity="center_vertical"
                android:id="@id/list_c_drive"
                android:background="@drawable/ripple_quick_access_item_bg"
                android:padding="@dimen/normal_margin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/local_disk_c"
                android:drawableLeft="@drawable/win_drive"
                android:drawablePadding="@dimen/medium_margin" />
            <TextView
                android:textSize="12.0sp"
                android:textColor="@android:color/black"
                android:gravity="center_vertical"
                android:id="@id/list_d_drive"
                android:background="@drawable/ripple_quick_access_item_bg"
                android:padding="@dimen/normal_margin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/local_disk_d"
                android:singleLine="true"
                android:drawableLeft="@drawable/drive"
                android:drawablePadding="@dimen/medium_margin" />
            <TextView
                android:textSize="12.0sp"
                android:textColor="@android:color/black"
                android:gravity="center_vertical"
                android:id="@id/list_e_drive"
                android:background="@drawable/ripple_quick_access_item_bg"
                android:padding="@dimen/normal_margin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/local_disk_e"
                android:singleLine="true"
                android:drawableLeft="@drawable/drive"
                android:drawablePadding="@dimen/medium_margin" />
            <ExpandableListView
                android:id="@id/network_listview"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:transcriptMode="alwaysScroll"
                android:groupIndicator="@drawable/group_indicator"
                android:divider="@null" />
        </LinearLayout>
        <View
            android:background="#ffd3d3d3"
            android:layout_width="1.0dip"
            android:layout_height="fill_parent" />
        <androidx.core.widget.NestedScrollView
            android:id="@id/nestedScrollView"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/this_pc"
                android:paddingTop="@dimen/normal_margin"
                android:visibility="visible"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <com.centsol.w10launcher.util.ScrollableGridView
                    android:gravity="center"
                    android:id="@id/gridView"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:listSelector="@android:color/transparent"
                    android:horizontalSpacing="10.0dip"
                    android:verticalSpacing="10.0dip"
                    android:columnWidth="80.0dip"
                    android:numColumns="auto_fit" />
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/drivesLayout"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@id/ll_c_drive"
                        android:background="@drawable/panel_front_rounded"
                        android:paddingLeft="@dimen/normal_margin"
                        android:paddingRight="@dimen/normal_margin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/normal_margin"
                        android:layout_marginRight="@dimen/normal_margin"
                        android:layout_marginHorizontal="@dimen/normal_margin"
                        android:paddingHorizontal="@dimen/normal_margin">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/local_drive" />
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textColor="@android:color/black"
                                android:id="@id/tv_c_drive_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/local_disk_c" />
                            <ProgressBar
                                android:id="@id/drive_c_progress"
                                android:layout_width="140.0dip"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/small_margin"
                                android:maxHeight="12.0dip"
                                android:max="100"
                                android:progress="60"
                                android:indeterminate="false"
                                android:progressDrawable="@drawable/progress_limit"
                                android:minHeight="12.0dip"
                                style="?android:progressBarStyleHorizontal" />
                            <TextView
                                android:textSize="@dimen/fm_text_small"
                                android:textColor="@android:color/darker_gray"
                                android:layout_gravity="center_horizontal"
                                android:id="@id/tv_drive_c_detail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/small_margin" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@id/ll_d_drive"
                        android:background="@drawable/panel_front_rounded"
                        android:paddingLeft="@dimen/normal_margin"
                        android:paddingRight="@dimen/normal_margin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/normal_margin"
                        android:layout_marginRight="@dimen/normal_margin"
                        android:layout_marginHorizontal="@dimen/normal_margin"
                        android:paddingHorizontal="@dimen/normal_margin">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/sd_card" />
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textColor="@android:color/black"
                                android:id="@id/tv_d_drive_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/local_disk_d" />
                            <ProgressBar
                                android:id="@id/drive_d_progress"
                                android:layout_width="140.0dip"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/small_margin"
                                android:maxHeight="12.0dip"
                                android:max="100"
                                android:progress="60"
                                android:indeterminate="false"
                                android:progressDrawable="@drawable/progress_limit"
                                android:minHeight="12.0dip"
                                style="?android:progressBarStyleHorizontal" />
                            <TextView
                                android:textSize="@dimen/fm_text_small"
                                android:textColor="@android:color/darker_gray"
                                android:layout_gravity="center_horizontal"
                                android:id="@id/tv_drive_d_detail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/small_margin" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@id/ll_e_drive"
                        android:background="@drawable/panel_front_rounded"
                        android:paddingLeft="@dimen/normal_margin"
                        android:paddingRight="@dimen/normal_margin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/normal_margin"
                        android:layout_marginRight="@dimen/normal_margin"
                        android:layout_marginHorizontal="@dimen/normal_margin"
                        android:paddingHorizontal="@dimen/normal_margin">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/usb_drive" />
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textColor="@android:color/black"
                                android:id="@id/tv_e_drive_title"
                                android:layout_width="wrap_content"
