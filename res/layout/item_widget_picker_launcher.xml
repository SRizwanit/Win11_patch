<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="4.0dip"
    android:paddingBottom="10.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingStart="6.0dip"
    android:paddingEnd="6.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:id="@id/widget_picker_launcher_card"
        android:background="@drawable/widget_picker_card"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="fill_parent"
        android:layout_height="132.0dip"
        android:foreground="?android:selectableItemBackground">
        <ImageView
            android:id="@id/widget_picker_launcher_preview"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_margin="12.0dip"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />
        <ImageView
            android:layout_gravity="end|center|top"
            android:id="@id/widget_picker_launcher_pro"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8.0dip"
            android:src="@drawable/pro_chip"
            android:contentDescription="@null" />
    </FrameLayout>
    <TextView
        android:textSize="13.0sp"
        android:textColor="#de000000"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@id/widget_picker_launcher_name"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:maxLines="1" />
</LinearLayout>