<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/bg_material_dialog"
    android:padding="@dimen/normal_margin"
    android:layout_width="fill_parent"
    android:layout_height="560.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/normal_margin">
        <ImageView
            android:id="@id/iv_back"
            android:padding="@dimen/normal_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_back"
            android:layout_centerVertical="true" />
        <ImageView
            android:id="@id/iv_pro_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/pro_chip"
            android:layout_centerInParent="true"
            android:translationZ="5.0dip" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="@android:color/black"
            android:id="@id/tv_default_color"
            android:background="@drawable/white_rounded_bg_action_center"
            android:padding="@dimen/normal_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/medium_margin"
            android:text="@string/set_default"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/normal_margin"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/normal_margin">
        <TextView
            android:textSize="14.0sp"
            android:textColor="@android:color/black"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/choose_text_color" />
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/large_margin">
            <androidx.cardview.widget.CardView
                android:id="@id/cardViewBlack"
                android:layout_width="50.0dip"
                android:layout_height="50.0dip"
                android:layout_margin="5.0dip"
                app:cardBackgroundColor="@android:color/black"
                app:cardCornerRadius="8.0dip">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@id/iv_black_selected"
                    android:background="@drawable/tickmark"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true" />
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@id/cardViewWhite"
                android:layout_width="50.0dip"
                android:layout_height="50.0dip"
                android:layout_margin="5.0dip"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="8.0dip">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@id/iv_white_selected"
                    android:background="@drawable/tickmark"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/white_rounded_corner_bg2"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14.0sp"
            android:textColor="@android:color/black"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/normal_margin"
            android:layout_marginTop="@dimen/normal_margin"
            android:text="@string/choose_background_color" />
        <GridView
            android:id="@id/gv_colors"
            android:padding="@dimen/medium_margin"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginTop="@dimen/large_margin"
            android:columnWidth="60.0dip"
            android:numColumns="auto_fit" />
    </LinearLayout>
</LinearLayout>