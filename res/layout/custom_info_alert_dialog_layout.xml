<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:theme="@style/AlertDialogCustom"
    android:id="@id/sv_infoDialog"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="8.0dip"
        android:paddingBottom="8.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24.0dip"
        android:paddingEnd="24.0dip">
        <TextView
            android:textAppearance="?textAppearanceBodyMedium"
            android:textColor="?colorOnSurfaceVariant"
            android:id="@id/tv_infoMessage"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10.0dip" />
        <ImageView
            android:layout_gravity="center"
            android:id="@id/iv_usernameInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/username_info"
            android:adjustViewBounds="true" />
    </LinearLayout>
</ScrollView>