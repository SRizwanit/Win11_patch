<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@id/icon_picker_frame"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@id/icon_picker_card"
        android:background="@drawable/bg_app_picker_card"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="56.0dip"
            android:layout_marginTop="8.0dip"
            android:paddingStart="8.0dip"
            android:paddingEnd="8.0dip">
            <ImageView
                android:id="@id/icon_picker_back"
                android:background="?android:selectableItemBackgroundBorderless"
                android:padding="12.0dip"
                android:layout_width="48.0dip"
                android:layout_height="48.0dip"
                android:src="@drawable/ic_arrow_back"
                android:tint="#de000000"
                android:contentDescription="@string/cancel" />
            <TextView
                android:textSize="22.0sp"
                android:textColor="#de000000"
                android:ellipsize="end"
                android:id="@id/icon_picker_title"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="@string/change_icon"
                android:maxLines="1"
                android:layout_weight="1.0"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="4.0dip" />
        </LinearLayout>
        <FrameLayout
            android:background="@drawable/bg_app_picker_search"
            android:layout_width="fill_parent"
            android:layout_height="44.0dip"
            android:layout_marginTop="4.0dip"
            android:layout_marginStart="20.0dip"
            android:layout_marginEnd="20.0dip">
            <ImageView
                android:layout_gravity="start|center"
                android:layout_width="20.0dip"
                android:layout_height="20.0dip"
                android:src="@drawable/search_icon"
                android:tint="#ff000000"
                android:contentDescription="@null"
                android:alpha="0.5"
                android:layout_marginStart="14.0dip" />
            <EditText
                android:textSize="15.0sp"
                android:textColor="#de000000"
                android:textColorHint="#61000000"
                android:id="@id/icon_picker_search"
                android:background="@null"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:hint="@string/icon_picker_search_hint"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:paddingStart="44.0dip"
                android:paddingEnd="44.0dip" />
            <ImageView
                android:layout_gravity="end|center"
                android:id="@id/icon_picker_clear"
                android:background="?android:selectableItemBackgroundBorderless"
                android:padding="12.0dip"
                android:visibility="gone"
                android:layout_width="44.0dip"
                android:layout_height="44.0dip"
                android:src="@drawable/ic_app_picker_clear"
                android:tint="#61000000"
                android:contentDescription="@string/cancel" />
        </FrameLayout>
        <FrameLayout
            android:background="@drawable/bg_app_picker_sheet"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_marginTop="16.0dip"
            android:layout_marginBottom="16.0dip"
            android:layout_weight="1.0"
            android:layout_marginStart="16.0dip"
            android:layout_marginEnd="16.0dip">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@id/icon_picker_grid"
                android:paddingTop="12.0dip"
                android:paddingBottom="12.0dip"
                android:scrollbars="vertical"
                android:clipToPadding="false"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:paddingStart="8.0dip"
                android:paddingEnd="8.0dip" />
            <TextView
                android:textSize="15.0sp"
                android:textColor="#99000000"
                android:layout_gravity="center"
                android:id="@id/icon_picker_empty"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_picker_empty" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>