<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:id="@id/ll_start_menu_main"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="bottom"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@id/visible_start_menu_icons"
        android:background="@android:color/transparent"
        android:visibility="visible"
        android:layout_width="40.0dip"
        android:layout_height="fill_parent"
        android:weightSum="2.0">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:weightSum="4.0"
            android:layout_weight="0.8">
            <ImageView
                android:id="@id/iv_menu"
                android:background="@drawable/panel_bg_rounded"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:src="@drawable/menu"
                android:scaleType="center"
                android:layout_weight="1.25" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:weightSum="6.0"
            android:layout_weight="1.2">
            <ImageView
                android:id="@id/iv_remove_ads"
                android:background="@drawable/panel_bg_rounded"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:src="@drawable/remove_ads"
                android:scaleType="center"
                android:layout_weight="1.0" />
            <ImageView
                android:id="@id/iv_search"
                android:background="@drawable/panel_bg_rounded"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:src="@drawable/search"
                android:scaleType="center"
                android:layout_weight="1.0" />
            <LinearLayout
                android:gravity="center"
                android:id="@id/ll_userName"
                android:background="@drawable/panel_bg_rounded"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_weight="1.0">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@id/iv_userName"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    android:src="@drawable/roundicon" />
            </LinearLayout>
            <ImageView
                android:id="@id/iv_file_explorer"
                android:background="@drawable/panel_bg_rounded"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:src="@drawable/file_explorer"
                android:scaleType="center"
                android:layout_weight="1.0" />
            <ImageView
                android:id="@id/iv_settings"
                android:background="@drawable/panel_bg_rounded"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:src="@drawable/settings"
                android:scaleType="center"
                android:layout_weight="1.0" />
            <ImageView
                android:id="@id/iv_power"
                android:background="@drawable/panel_bg_rounded"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:src="@drawable/power"
                android:scaleType="center"
                android:layout_weight="1.0" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@id/hidden_start_menu_text"
        android:background="#e6171717"
        android:visibility="gone"
        android:layout_width="130.0dip"
        android:layout_height="fill_parent"
        android:weightSum="2.0"
        android:animateLayoutChanges="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:weightSum="4.0"
            android:layout_weight="0.8">
            <TextView
                android:textSize="17.0sp"
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:id="@id/tv_menu"
                android:paddingLeft="10.0dip"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:text="@string/start"
                android:shadowColor="@android:color/black"
                android:shadowDx="2.0"
                android:shadowDy="2.0"
                android:shadowRadius="2.0"
                android:layout_weight="1.25" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:weightSum="6.0"
            android:layout_weight="1.2">
            <TextView
                android:textSize="17.0sp"
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:id="@id/tv_remove_ads"
                android:paddingLeft="10.0dip"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:text="@string/remove_ads"
                android:shadowColor="@android:color/black"
                android:shadowDx="2.0"
                android:shadowDy="2.0"
                android:shadowRadius="2.0"
                android:layout_weight="1.0" />
            <TextView
                android:textSize="17.0sp"
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:id="@id/tv_search"
                android:paddingLeft="10.0dip"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:text="@string/search"
                android:shadowColor="@android:color/black"
                android:shadowDx="2.0"
                android:shadowDy="2.0"
                android:shadowRadius="2.0"
                android:layout_weight="1.0" />
            <TextView
                android:textSize="17.0sp"
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:id="@id/tv_userName"
                android:paddingLeft="10.0dip"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:text="@string/admin"
                android:shadowColor="@android:color/black"
                android:shadowDx="2.0"
                android:shadowDy="2.0"
                android:shadowRadius="2.0"
                android:layout_weight="1.0" />
            <TextView
                android:textSize="17.0sp"
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:id="@id/tv_file_explorer"
                android:paddingLeft="10.0dip"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:text="@string/file_explorer"
                android:shadowColor="@android:color/black"
                android:shadowDx="2.0"
                android:shadowDy="2.0"
                android:shadowRadius="2.0"
                android:layout_weight="1.0" />
            <TextView
                android:textSize="17.0sp"
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:id="@id/tv_settings"
                android:paddingLeft="10.0dip"
                android:paddingRight="10.0dip"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:text="@string/settings_launcher"
                android:shadowColor="@android:color/black"
                android:shadowDx="2.0"
                android:shadowDy="2.0"
                android:shadowRadius="2.0"
                android:drawableRight="@drawable/right_arrow_white"
                android:layout_weight="1.0" />
            <TextView
                android:textSize="17.0sp"
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:id="@id/tv_power"
                android:paddingLeft="10.0dip"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:text="@string/power"
                android:shadowColor="@android:color/black"
                android:shadowDx="2.0"
                android:shadowDy="2.0"
                android:shadowRadius="2.0"
                android:layout_weight="1.0" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>