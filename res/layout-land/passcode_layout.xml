<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@id/profile_icon"
            android:background="@drawable/user_pic"
            android:layout_width="90.0dip"
            android:layout_height="90.0dip"
            android:layout_marginTop="@dimen/normal_margin"
            android:layout_centerHorizontal="true" />
        <TextView
            android:textSize="20.0sp"
            android:textColor="#ffffffff"
            android:id="@id/tv_username_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/medium_margin"
            android:layout_below="@id/profile_icon"
            android:layout_centerHorizontal="true" />
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_below="@id/tv_username_password">
            <RelativeLayout
                android:id="@id/lout_dot"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin">
                <RelativeLayout
                    android:id="@id/shakelayout"
                    android:background="@drawable/white_rounded_bg_action_center"
                    android:layout_width="240.0dip"
                    android:layout_height="35.0dip"
                    android:layout_centerHorizontal="true">
                    <ImageView
                        android:id="@id/iv_pass_one"
                        android:layout_width="15.0dip"
                        android:layout_height="15.0dip"
                        android:layout_marginLeft="@dimen/normal_margin"
                        android:layout_marginRight="@dimen/medium_margin"
                        android:layout_centerVertical="true" />
                    <ImageView
                        android:id="@id/iv_pass_two"
                        android:layout_width="15.0dip"
                        android:layout_height="15.0dip"
                        android:layout_marginRight="@dimen/medium_margin"
                        android:layout_toRightOf="@id/iv_pass_one"
                        android:layout_centerInParent="true" />
                    <ImageView
                        android:id="@id/iv_pass_three"
                        android:layout_width="15.0dip"
                        android:layout_height="15.0dip"
                        android:layout_marginRight="@dimen/medium_margin"
                        android:layout_toRightOf="@id/iv_pass_two"
                        android:layout_centerInParent="true" />
                    <ImageView
                        android:id="@id/iv_pass_four"
                        android:layout_width="15.0dip"
                        android:layout_height="15.0dip"
                        android:layout_marginRight="@dimen/medium_margin"
                        android:layout_toRightOf="@id/iv_pass_three"
                        android:layout_centerInParent="true" />
                    <ImageView
                        android:id="@id/iv_pass_five"
                        android:layout_width="15.0dip"
                        android:layout_height="15.0dip"
                        android:layout_toRightOf="@id/iv_pass_four"
                        android:layout_centerInParent="true" />
                    <ImageView
                        android:id="@id/iv_confirm_pass"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/medium_margin"
                        android:src="@drawable/arrow_black"
                        android:layout_alignParentRight="true"
                        android:layout_centerInParent="true" />
                </RelativeLayout>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/normal_margin"
                android:weightSum="4.0"
                android:layout_below="@id/lout_dot">
                <LinearLayout
                    android:gravity="center"
                    android:id="@id/lot_num_line1"
                    android:layout_width="fill_parent"
                    android:layout_height="0.0dip"
                    android:layout_weight="1.0">
                    <ImageView
                        android:id="@id/iv_num_one"
                        android:background="@drawable/button1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <ImageView
                        android:id="@id/iv_num_two"
                        android:background="@drawable/button2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <ImageView
                        android:id="@id/iv_num_three"
                        android:background="@drawable/button3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:id="@id/lot_num_line2"
                    android:layout_width="fill_parent"
                    android:layout_height="0.0dip"
                    android:layout_weight="1.0">
                    <ImageView
                        android:id="@id/iv_num_four"
                        android:background="@drawable/button4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <ImageView
                        android:id="@id/iv_num_five"
                        android:background="@drawable/button5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <ImageView
                        android:id="@id/iv_num_six"
                        android:background="@drawable/button6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:id="@id/lot_num_line3"
                    android:layout_width="fill_parent"
                    android:layout_height="0.0dip"
                    android:layout_weight="1.0">
                    <ImageView
                        android:id="@id/iv_num_seven"
                        android:background="@drawable/button7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <ImageView
                        android:id="@id/iv_num_eight"
                        android:background="@drawable/button8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <ImageView
                        android:id="@id/iv_num_nine"
                        android:background="@drawable/button9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="fill_parent"
                    android:layout_height="0.0dip"
                    android:layout_weight="1.0">
                    <ImageView
                        android:background="@drawable/button0"
                        android:visibility="invisible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <ImageView
                        android:id="@id/iv_num_zero"
                        android:background="@drawable/button0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <ImageView
                        android:id="@id/iv_delete_text"
                        android:background="@drawable/button_delete"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>