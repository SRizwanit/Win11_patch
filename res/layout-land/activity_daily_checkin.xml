<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="@color/light_gray_bg_color"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@id/toolbar"
        android:layout_width="fill_parent"
        android:layout_height="?actionBarSize"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@id/btn_back"
            android:padding="8.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_back"
            android:layout_centerVertical="true"
            android:layout_marginStart="16.0dip" />
        <TextView
            android:textSize="20.0sp"
            android:textColor="#ff333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/daily_checkin_title"
            android:layout_centerInParent="true" />
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:paddingLeft="100.0dip"
            android:paddingRight="100.0dip"
            android:paddingBottom="24.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="100.0dip">
            <ImageView
                android:id="@id/iv_main_illustration"
                android:layout_width="240.0dip"
                android:layout_height="240.0dip"
                android:layout_marginTop="16.0dip"
                android:src="@drawable/checkin_icon"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@id/tv_day"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />
            <TextView
                android:textSize="44.0sp"
                android:textStyle="bold"
                android:textColor="#ffe64a19"
                android:id="@id/tv_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.0dip"
                app:layout_constraintBottom_toTopOf="@id/ll_reward_1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_main_illustration" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/ll_reward_1"
                android:paddingLeft="20.0dip"
                android:paddingTop="12.0dip"
                android:paddingRight="20.0dip"
                android:paddingBottom="12.0dip"
                android:layout_width="380.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="24.0dip"
                android:paddingHorizontal="20.0dip"
                android:paddingVertical="12.0dip"
                app:layout_constraintBottom_toTopOf="@id/tv_or"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_day">
                <ImageView
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:src="@drawable/discount_icon" />
                <TextView
                    android:textSize="15.0sp"
                    android:textColor="#ff666666"
                    android:id="@id/tv_discount_reward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/discount_reward_text"
                    android:layout_marginStart="16.0dip" />
            </LinearLayout>
            <TextView
                android:textSize="12.0sp"
                android:textColor="#ffbbbbbb"
                android:id="@id/tv_or"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:layout_marginBottom="8.0dip"
                android:text="@string/or_text"
                android:layout_marginVertical="8.0dip"
                app:layout_constraintBottom_toTopOf="@id/ll_reward_2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ll_reward_1" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/ll_reward_2"
                android:paddingLeft="20.0dip"
                android:paddingTop="12.0dip"
                android:paddingRight="20.0dip"
                android:paddingBottom="12.0dip"
                android:layout_width="380.0dip"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20.0dip"
                android:paddingVertical="12.0dip"
                app:layout_constraintBottom_toTopOf="@id/ll_streak"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_or">
                <ImageView
                    android:layout_width="24.0dip"
                    android:layout_height="24.0dip"
                    android:src="@drawable/theme_icon" />
                <TextView
                    android:textSize="15.0sp"
                    android:textColor="#ff666666"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_reward_text"
                    android:layout_marginStart="16.0dip" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@id/ll_streak"
                android:layout_width="380.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="24.0dip"
                app:layout_constraintBottom_toTopOf="@id/btn_claim"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ll_reward_2">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <ImageView
                        android:layout_width="28.0dip"
                        android:layout_height="28.0dip"
                        android:src="@drawable/streak_active" />
                    <TextView
                        android:textSize="11.0sp"
                        android:textStyle="bold"
                        android:textColor="#ffe64a19"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4.0dip"
                        android:text="5%" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <ImageView
                        android:layout_width="28.0dip"
                        android:layout_height="28.0dip"
                        android:src="@drawable/streak_disable" />
                    <TextView
                        android:textSize="11.0sp"
                        android:textColor="#ffbbbbbb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4.0dip"
                        android:text="10%" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <ImageView
                        android:layout_width="28.0dip"
                        android:layout_height="28.0dip"
                        android:src="@drawable/streak_disable" />
                    <TextView
                        android:textSize="11.0sp"
                        android:textColor="#ffbbbbbb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4.0dip"
                        android:text="15%" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <ImageView
                        android:layout_width="28.0dip"
                        android:layout_height="28.0dip"
                        android:src="@drawable/streak_disable" />
                    <TextView
                        android:textSize="11.0sp"
                        android:textColor="#ffbbbbbb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4.0dip"
                        android:text="20%" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <ImageView
                        android:layout_width="28.0dip"
                        android:layout_height="28.0dip"
                        android:src="@drawable/streak_disable" />
                    <TextView
                        android:textSize="11.0sp"
                        android:textColor="#ffbbbbbb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4.0dip"
                        android:text="25%" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <ImageView
                        android:layout_width="28.0dip"
                        android:layout_height="28.0dip"
                        android:src="@drawable/streak_disable" />
                    <TextView
                        android:textSize="11.0sp"
                        android:textColor="#ffbbbbbb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4.0dip"
                        android:text="30%" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <ImageView
                        android:layout_width="28.0dip"
                        android:layout_height="28.0dip"
                        android:src="@drawable/streak_disable" />
                    <TextView
                        android:textSize="11.0sp"
                        android:textColor="#ffbbbbbb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4.0dip"
                        android:text="35%" />
                </LinearLayout>
            </LinearLayout>
            <Button
                android:textSize="18.0sp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:id="@id/btn_claim"
                android:background="@drawable/bg_claim_button"
                android:layout_width="280.0dip"
                android:layout_height="56.0dip"
                android:layout_marginTop="32.0dip"
                android:text="@string/claim_button_text"
                android:textAllCaps="false"
                app:backgroundTint="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ll_streak" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>